---
/**
 * Shop Page
 *
 * The Small Talk Café merch store has been permanently closed.
 * This page remains live to handle old links gracefully.
 *
 * Route: /shop
 */

import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = 'Shop | Small Talk Café';
const description =
  'The Small Talk Café merch store is now closed. Browse our free German language learning podcasts on Spotify and Apple Podcasts.';
---

<BaseLayout title={title} description={description}>
  <div class="min-h-screen flex flex-col bg-brand-background">
    <Header />

    <main class="flex-grow">

      <!-- Closed notice -->
      <section class="py-16 md:py-24 px-4">
        <div class="container-custom max-w-2xl mx-auto text-center">

          <p class="text-5xl mb-6" aria-hidden="true">☕</p>

          <h1 class="text-4xl md:text-5xl font-bold text-brand-secondary leading-tight mb-5">
            The Shop is Now Closed
          </h1>

          <p class="text-brand-secondary/70 leading-relaxed text-base md:text-lg mb-4">
            We've decided to close the Small Talk Café merch store. Thank you to everyone
            who showed interest — we genuinely appreciate the support.
          </p>

          <p class="text-brand-secondary/70 leading-relaxed text-base md:text-lg mb-10">
            Our podcasts remain completely free. If you have a question or a pending
            order inquiry, please reach out to us directly.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href={`${base}/shows/`}
              class="inline-flex items-center justify-center gap-2 bg-brand-secondary text-brand-background font-heading font-bold px-7 py-3.5 rounded-full hover:opacity-85 transition-opacity text-base"
            >
              Browse Our Shows
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
            <a
              href="mailto:smalltalkcafe.productions@gmail.com"
              class="inline-flex items-center justify-center gap-2 border-2 border-brand-secondary text-brand-secondary font-heading font-bold px-7 py-3.5 rounded-full hover:opacity-80 transition-opacity text-base"
            >
              Contact Us
            </a>
          </div>

        </div>
      </section>

    </main>

    <Footer />
  </div>
</BaseLayout>
