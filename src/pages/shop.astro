---
/**
 * Shop Page
 *
 * Dedicated merch hub for Small Talk Café. Products are fetched live from
 * the Shopify storefront at build time — any change you make in Shopify
 * will appear here on the next CI build (or the weekly automated rebuild).
 *
 * No manual maintenance required.
 *
 * Route: /shop
 */

import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { siteConfig } from '@/config/site';
import { fetchShopifyProducts, formatPrice } from '@/utils/shopify';

const shopUrl = siteConfig.socialLinks.shopify;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Fetch all live products at build time — returns [] gracefully on error
const products = await fetchShopifyProducts();
const hasProducts = products.length > 0;

const title = 'Merch Shop | Small Talk Café — Language Learning Gear';
const description =
  'Deck out in Small Talk Café gear while you practice your German. Shop hoodies, mugs, tote bags and more. Perfect gifts for language learners and German culture lovers.';
---

<BaseLayout title={title} description={description}>
  <div class="min-h-screen flex flex-col bg-brand-background">
    <Header />

    <main class="flex-grow">

      <!-- Hero -->
      <section class="py-16 md:py-24">
        <div class="container-custom text-center max-w-2xl mx-auto px-4">
          <h1 class="text-4xl md:text-5xl font-bold text-brand-secondary leading-tight mb-5">
            Merch for German<br />Language Learners
          </h1>
          <p class="text-brand-secondary/70 leading-relaxed text-base md:text-lg mb-4">
            Small Talk Café is the free German-learning podcast built on one idea: Deutsch should feel like
            a conversation over coffee, not a grammar exam. Our merchandise carries that same spirit — every
            mug, t-shirt, and tote is a wearable reminder that German is approachable, fun, and yours to own.
          </p>
          <p class="text-brand-secondary/70 leading-relaxed text-base md:text-lg mb-8">
            Searching for the perfect German learner gift — for yourself or a fellow Deutschlerner? From
            <em>Bier Essentials</em> mugs and <em>Brezel</em> ceramics to our German Essentials t-shirt
            range, every piece is a conversation starter in any language.
          </p>
          <a
            href={shopUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-brand-secondary text-brand-background font-heading font-bold px-7 py-3.5 rounded-full hover:opacity-85 transition-opacity text-base"
          >
            Shop Everything
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </a>
        </div>
      </section>

      <!-- Live Products Grid (populated from Shopify at build time) -->
      <section class="py-12 md:py-16" aria-labelledby="products-heading">
        <div class="container-custom px-4">
          <h2 id="products-heading" class="text-2xl md:text-3xl font-bold text-brand-secondary text-center mb-2">
            {hasProducts ? 'Our Products' : 'Browse the Store'}
          </h2>
          <p class="text-center text-brand-secondary/60 text-sm mb-10">
            {!hasProducts && 'Visit our Shopify store to see all available products.'}
          </p>

          {hasProducts ? (
            <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 max-w-7xl mx-auto list-none p-0">
              {products.map((product) => {
                const image = product.images[0];
                const onSale = product.compareAtPrice &&
                  parseFloat(product.compareAtPrice) > parseFloat(product.price);
                return (
                  <li>
                    <a
                      href={product.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="product-card group"
                      aria-label={`${product.title} — ${formatPrice(product.price)}`}
                    >
                      <!-- Product image -->
                      <div class="product-img-wrap">
                        {image ? (
                          <img
                            src={image.src}
                            alt={image.alt ?? product.title}
                            width={image.width || 600}
                            height={image.height || 600}
                            loading="lazy"
                            decoding="async"
                            class="product-img"
                          />
                        ) : (
                          <div class="product-img-placeholder" aria-hidden="true">🛍️</div>
                        )}
                        {onSale && (
                          <span class="sale-badge" aria-label="On sale">Sale</span>
                        )}
                        {!product.available && (
                          <span class="sold-out-badge" aria-label="Sold out">Sold Out</span>
                        )}
                      </div>

                      <!-- Product info -->
                      <div class="product-info">
                        {product.productType && (
                          <p class="product-type">{product.productType}</p>
                        )}
                        <h3 class="product-title group-hover:text-brand-accent transition-colors">
                          {product.title}
                        </h3>
                        {product.teaser && (
                          <p class="product-teaser">{product.teaser}</p>
                        )}
                        <div class="product-price-row">
                          <span class="product-price">{formatPrice(product.price)}</span>
                          {onSale && product.compareAtPrice && (
                            <span class="product-compare-price">
                              {formatPrice(product.compareAtPrice)}
                            </span>
                          )}
                        </div>
                        <span class="product-cta" aria-hidden="true">
                          Shop Now
                          <svg class="w-4 h-4 inline-block ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                          </svg>
                        </span>
                      </div>
                    </a>
                  </li>
                );
              })}
            </ul>
          ) : (
            <!-- Fallback when Shopify is unreachable at build time -->
            <div class="text-center py-12">
              <p class="text-4xl mb-4" aria-hidden="true">🛍️</p>
              <p class="text-brand-secondary/70 mb-6">
                Head over to our Shopify store to browse the full collection.
              </p>
              <a
                href={shopUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 bg-brand-secondary text-brand-background font-heading font-bold px-6 py-3 rounded-full hover:opacity-85 transition-opacity"
              >
                Visit the Store
              </a>
            </div>
          )}
        </div>
      </section>

      <!-- Listen + Shop Cross-link -->
      <section class="py-10 bg-brand-secondary" aria-labelledby="listen-heading">
        <div class="container-custom max-w-3xl mx-auto px-4 text-center">
          <h2 id="listen-heading" class="text-xl md:text-2xl font-bold text-brand-background mb-3">
            New to Small Talk Café?
          </h2>
          <p class="text-brand-background/75 mb-6 text-sm md:text-base">
            Start with our free German-learning podcasts — bite-sized episodes, new every week.
          </p>
          <a
            href={`${base}/shows/`}
            class="inline-flex items-center gap-2 bg-brand-background text-brand-secondary font-heading font-bold px-6 py-3 rounded-full hover:opacity-90 transition-opacity text-sm"
          >
            Browse All Shows
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
        </div>
      </section>

    </main>

    <Footer />
  </div>
</BaseLayout>

<style>

  /* ── Product card ─────────────────────────────────────────────────── */
  .product-card {
    display: flex;
    flex-direction: column;
    background: white;
    border: 1.5px solid rgba(82, 62, 38, 0.08);
    border-radius: 20px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.2s, transform 0.2s;
    height: 100%;
  }
  .product-card:hover {
    box-shadow: 0 8px 30px rgba(82, 62, 38, 0.12);
    transform: translateY(-2px);
  }

  .product-img-wrap {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #f5f1e8;
  }
  .product-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .product-card:hover .product-img {
    transform: scale(1.04);
  }
  .product-img-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    font-size: 3.5rem;
  }

  .sale-badge,
  .sold-out-badge {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.2rem 0.55rem;
    border-radius: 99px;
  }
  .sale-badge {
    background: #F39C12;
    color: white;
  }
  .sold-out-badge {
    background: rgba(82, 62, 38, 0.65);
    color: white;
  }

  .product-info {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.1rem 1.25rem 1.35rem;
    flex-grow: 1;
  }

  .product-type {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #F39C12;
    margin: 0;
  }

  .product-title {
    font-family: "Poppins", "Helvetica Neue", sans-serif;
    font-size: 0.975rem;
    font-weight: 700;
    color: #523E26;
    margin: 0;
    line-height: 1.35;
  }

  .product-teaser {
    font-size: 0.8rem;
    color: rgba(82, 62, 38, 0.6);
    margin: 0;
    line-height: 1.5;
    flex-grow: 1;
    /* clamp to 2 lines */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .product-price-row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  .product-price {
    font-family: "Poppins", "Helvetica Neue", sans-serif;
    font-size: 1rem;
    font-weight: 700;
    color: #523E26;
  }

  .product-compare-price {
    font-size: 0.8rem;
    color: rgba(82, 62, 38, 0.45);
    text-decoration: line-through;
  }

  .product-cta {
    display: inline-flex;
    align-items: center;
    font-size: 0.8rem;
    font-weight: 600;
    color: #F39C12;
    margin-top: 0.5rem;
    transition: gap 0.15s;
  }
  .product-card:hover .product-cta {
    gap: 0.35rem;
  }
</style>
