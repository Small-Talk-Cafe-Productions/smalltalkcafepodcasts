---
/**
 * Homepage
 *
 * SEO hub: H1 keyword target, dynamic latest episode, all 4 language shows
 * with targeted keyword headings, shop CTA, and rich JSON-LD graph.
 */

import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { siteConfig } from '@/config/site';
import {
  generatePodcastSchema,
  generateOrganizationSchema,
  generateWebSiteSchema,
  formatDate,
} from '@/config/seo';
import { fetchLatestEpisodePerShow } from '@/utils/rss';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { seo, shows, socialLinks } = siteConfig;

// Fetch the latest episode per show for the homepage rows
const latestPerShow = await fetchLatestEpisodePerShow(shows);

// Build JSON-LD graph: Organization + WebSite + 4x PodcastSeries
const orgSchema = generateOrganizationSchema(seo, socialLinks);
const siteSchema = generateWebSiteSchema(seo);
const showSchemas = shows.map((s) => generatePodcastSchema(s, seo));

// Language-specific targeted headings for each show
const showHeadings: Record<string, string> = {
  'english-german': 'Learn German for English Speakers',
  'spanish-german': 'Aprender alemán para hispanohablantes',
  'french-german': 'Apprendre l\'allemand pour les francophones',
  'italian-german': 'Imparare il tedesco per italofoni',
};

const pageTitle = 'Small Talk Café | Speak German with Confidence — Bite-Sized Podcast';
const pageDescription =
  'Build real German speaking confidence with Small Talk Café — bite-sized podcast episodes for English, Spanish, French & Italian speakers. New episodes every week on Spotify & Apple.';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <Fragment slot="head-extras">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
    {showSchemas.map((s) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
  </Fragment>

  <div class="min-h-screen flex flex-col bg-brand-background">
    <Header />

    <main class="flex-grow">

      <!-- ── Hero ─────────────────────────────────────────────────────── -->
      <section class="py-10 md:py-16 text-center px-4">
        <div class="container-custom max-w-3xl mx-auto">
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-brand-secondary leading-tight mb-5">
            Speak German with Confidence —<br class="hidden md:block" /> Bite-Sized Podcast Lessons
          </h1>
          <p class="text-brand-secondary/70 text-lg md:text-xl leading-relaxed mb-8 max-w-2xl mx-auto">
            Small Talk Café gives you the German speaking practice you need, in minutes a day.
            Real conversations, no textbook. Available in multiple native languages.
          </p>
          <div class="flex flex-wrap gap-3 justify-center">
            <a
              href={`${base}/shows/`}
              class="inline-flex items-center gap-2 bg-brand-secondary text-brand-background font-heading font-bold px-7 py-3.5 rounded-full hover:opacity-85 transition-opacity text-base"
            >
              Browse All Shows
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
            <a
              href={`${base}/shop/`}
              class="inline-flex items-center gap-2 bg-brand-secondary text-brand-background font-heading font-bold px-7 py-3.5 rounded-full hover:opacity-85 transition-opacity text-base"
            >
              Visit the Shop
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
              </svg>
            </a>
          </div>
        </div>
      </section>

      <!-- ── Our Shows ─────────────────────────────────────────────────── -->
      <section class="py-8 md:py-12 px-4" aria-labelledby="shows-heading">
        <div class="container-custom max-w-5xl mx-auto">
          <h2 id="shows-heading" class="text-2xl md:text-3xl font-bold text-brand-secondary text-center mb-2">
            Our Shows
          </h2>
          <p class="text-center text-brand-secondary/60 text-sm mb-10">
            Bite-sized German speaking practice — pick your show and start today.
          </p>
          <ul class="flex flex-col gap-5 list-none p-0">
            {shows.map((show) => {
              const ep = latestPerShow[show.id];
              return (
                <li class="show-row">
                  <!-- Show info -->
                  <div class="show-row-left">
                    <a
                      href={`${base}/shows/${show.id}/`}
                      tabindex="-1"
                      aria-hidden="true"
                      class="show-row-art-link"
                    >
                      <img
                        src={show.artworkUrl}
                        alt={`${show.title} artwork`}
                        width="128"
                        height="128"
                        loading="lazy"
                        decoding="async"
                        class="show-row-art"
                      />
                    </a>
                    <div class="show-row-meta">
                      <h3 class="show-row-heading">
                        {showHeadings[show.id] ?? show.subtitle ?? show.title}
                      </h3>
                      <p class="show-row-desc">{show.description}</p>
                      <a href={`${base}/shows/${show.id}/`} class="show-row-cta">
                        All Episodes →
                      </a>
                    </div>
                  </div>

                  <!-- Latest episode -->
                  <div class="show-row-episode">
                    <p class="episode-eyebrow">Latest Episode</p>
                    {ep ? (
                      <>
                        <h4 class="episode-title">{ep.episode.title}</h4>
                        {ep.episode.pubDate && (
                          <p class="episode-date">
                            <time datetime={ep.episode.pubDate}>{formatDate(ep.episode.pubDate)}</time>
                          </p>
                        )}
                        {ep.episode.description && (
                          <p class="episode-desc">{ep.episode.description}</p>
                        )}
                        <a
                          href={`${base}/shows/${show.id}/${ep.episode.slug}/`}
                          class="episode-listen-btn"
                        >
                          Listen Now
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                          </svg>
                        </a>
                      </>
                    ) : (
                      <p class="show-row-desc" style="margin-top: 0.25rem;">New episodes coming soon.</p>
                    )}
                  </div>
                </li>
              );
            })}
          </ul>
        </div>
      </section>

      <!-- ── Shop CTA ───────────────────────────────────────────────────── -->
      <section class="py-14 md:py-20 bg-brand-secondary px-4" aria-labelledby="shop-cta-heading">
        <div class="container-custom max-w-3xl mx-auto text-center">
          <p class="text-xs uppercase tracking-widest text-brand-background/50 font-semibold mb-3">Merch</p>
          <h2 id="shop-cta-heading" class="text-2xl md:text-3xl font-bold text-brand-background mb-4 leading-snug">
            Wear Your German Journey
          </h2>
          <p class="text-brand-background/75 text-base md:text-lg leading-relaxed mb-8 max-w-xl mx-auto">
            From <em>Bier Essentials</em> mugs to German Essentials tees — browse exclusive gear made for
            language learners and German culture lovers.
          </p>
          <a
            href={`${base}/shop/`}
            class="inline-flex items-center gap-2 bg-brand-background text-brand-secondary font-heading font-bold px-8 py-4 rounded-full hover:opacity-90 transition-opacity text-base"
          >
            Visit the Shop
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
            </svg>
          </a>
        </div>
      </section>

    </main>

    <Footer />
  </div>
</BaseLayout>

<style>
  /* Show rows */
  .show-row {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    background: white;
    border-radius: 20px;
    border: 1.5px solid rgba(82, 62, 38, 0.08);
    padding: 1.5rem;
    box-shadow: 0 2px 12px rgba(82, 62, 38, 0.05);
  }
  @media (min-width: 1024px) {
    .show-row { flex-direction: row; align-items: flex-start; }
  }

  /* Left: show info */
  .show-row-left {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    flex-shrink: 0;
  }
  @media (min-width: 1024px) {
    .show-row-left { width: 42%; }
  }
  .show-row-art-link { flex-shrink: 0; }
  .show-row-art {
    width: 110px;
    height: 110px;
    border-radius: 14px;
    object-fit: cover;
    flex-shrink: 0;
  }
  @media (min-width: 640px) {
    .show-row-art { width: 128px; height: 128px; }
  }
  .show-row-meta {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .show-row-heading {
    font-family: var(--font-heading, 'Poppins', sans-serif);
    font-size: 1rem;
    font-weight: 700;
    color: #523E26;
    line-height: 1.3;
    margin: 0;
  }
  @media (min-width: 768px) {
    .show-row-heading { font-size: 1.0625rem; }
  }
  .show-row-desc {
    font-size: 0.8125rem;
    color: rgba(82, 62, 38, 0.65);
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .show-row-cta {
    font-size: 0.8125rem;
    font-weight: 700;
    color: #F39C12;
    text-decoration: none;
    margin-top: 0.25rem;
    align-self: flex-start;
  }
  .show-row-cta:hover { text-decoration: underline; }

  /* Right: latest episode */
  .show-row-episode {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(82, 62, 38, 0.08);
  }
  @media (min-width: 1024px) {
    .show-row-episode {
      flex: 1;
      padding-top: 0;
      padding-left: 1.5rem;
      border-top: none;
      border-left: 1px solid rgba(82, 62, 38, 0.1);
    }
  }
  .episode-eyebrow {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
    color: rgba(82, 62, 38, 0.45);
    margin: 0;
  }
  .episode-title {
    font-family: var(--font-heading, 'Poppins', sans-serif);
    font-size: 0.9375rem;
    font-weight: 700;
    color: #523E26;
    line-height: 1.35;
    margin: 0;
  }
  @media (min-width: 768px) {
    .episode-title { font-size: 1rem; }
  }
  .episode-date {
    font-size: 0.75rem;
    color: rgba(82, 62, 38, 0.5);
    margin: 0;
  }
  .episode-desc {
    font-size: 0.8125rem;
    color: rgba(82, 62, 38, 0.65);
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .episode-listen-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    background: #F39C12;
    color: white;
    font-family: var(--font-heading, 'Poppins', sans-serif);
    font-weight: 700;
    font-size: 0.8125rem;
    padding: 0.5rem 1.125rem;
    border-radius: 9999px;
    text-decoration: none;
    margin-top: 0.375rem;
    align-self: flex-start;
    transition: opacity 0.2s;
  }
  .episode-listen-btn:hover { opacity: 0.85; }
</style>

