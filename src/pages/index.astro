---
/**
 * Homepage
 *
 * Brand pivot: Small Talk Café is now a multilingual language-learning network.
 * Shows only English-speaker shows (one per target language) to keep the homepage clean.
 * The /shows/ page has all variants grouped by target language.
 */

import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { siteConfig } from '@/config/site';

import {
  generatePodcastSchema,
  generateOrganizationSchema,
  generateWebSiteSchema,
  formatDate,
} from '@/config/seo';
import { fetchLatestEpisodePerShow } from '@/utils/rss';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { seo, shows, socialLinks } = siteConfig;

// Homepage only shows English-speaker shows (one per target language)
const featuredShows = shows.filter((s) => s.language === 'en');

// Fetch latest episode for each featured show
const latestPerShow = await fetchLatestEpisodePerShow(featuredShows);

// Build JSON-LD graph: Organization + WebSite + all show schemas (for full SEO coverage)
const orgSchema = generateOrganizationSchema(seo, socialLinks);
const siteSchema = generateWebSiteSchema(seo);
const showSchemas = shows.map((s) => generatePodcastSchema(s, seo));

const pageTitle = 'Small Talk Café | Learn Any Language in Minutes — Bite-Sized Podcast';
const pageDescription =
  'Learn Spanish, French, Italian, Portuguese, Dutch, Swedish, Japanese, Korean, Mandarin, or German with Small Talk Café — bite-sized podcast episodes with real everyday conversations. New episodes every day on Spotify & Apple Podcasts.';

const firstShow = featuredShows[0];
const _firstArtFile = firstShow?.artworkUrl ? firstShow.artworkUrl.split('/').pop() : '';
const _firstArtName = _firstArtFile ? _firstArtFile.replace(/\.[^.]+$/, '') : '';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <Fragment slot="head-extras">
    {_firstArtName && (
      <link rel="preload" as="image" href={`/images/optimized/${_firstArtName}-320.avif`} type="image/avif" />
    )}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
    {showSchemas.map((s) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
  </Fragment>

  <div class="min-h-screen flex flex-col bg-brand-background">
    <Header />

    <main class="flex-grow">

      <!-- ── Hero ─────────────────────────────────────────────────────── -->
      <section class="py-8 md:py-12 text-center px-4">
        <div class="container-custom max-w-3xl mx-auto">
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-brand-secondary leading-tight mb-5">
            Speak Any Language<br class="hidden md:block" /> with Confidence — Bite-Sized Podcast Lessons
          </h1>
          <div class="flex flex-wrap gap-3 justify-center mt-8">
            <a
              href={`${base}/shows/`}
              class="inline-flex items-center gap-2 bg-brand-secondary text-brand-background font-heading font-bold px-7 py-3.5 rounded-full hover:opacity-85 transition-opacity text-base"
            >
              Browse All Shows
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
          </div>
        </div>
      </section>



      <!-- ── Our Shows ─────────────────────────────────────────────────── -->
      <section class="py-4 md:py-8 px-4" aria-labelledby="shows-heading">
        <div class="container-custom max-w-5xl mx-auto">
          <h2 id="shows-heading" class="text-2xl md:text-3xl font-bold text-brand-secondary text-center mb-2">
            Our Shows
          </h2>
          <p class="text-center text-brand-secondary/60 text-sm mb-10">
            Bite-sized podcast lessons for English speakers — pick your language and start today.
          </p>
          <ul class="flex flex-col gap-5 list-none p-0">
            {featuredShows.map((show) => {
              const ep = latestPerShow[show.id];
              const _artFile = show.artworkUrl ? show.artworkUrl.split('/').pop() : '';
              const _artName = _artFile ? _artFile.replace(/\.[^.]+$/, '') : 'podcasts';
              return (
                <li class="show-row">
                  <!-- Show info -->
                  <div class="show-row-left">
                    <a
                      href={`${base}/shows/${show.id}/`}
                      tabindex="-1"
                      aria-hidden="true"
                      class="show-row-art-link"
                    >
                      <picture>
                        <source
                          type="image/avif"
                          srcset={['184','150','320'].map(w => `/images/optimized/${_artName}-${w}.avif ${w}w`).join(', ')}
                          sizes="184px"
                        />
                        <source
                          type="image/webp"
                          srcset={['184','150','320'].map(w => `/images/optimized/${_artName}-${w}.webp ${w}w`).join(', ')}
                          sizes="184px"
                        />
                        <img
                          src={show.artworkUrl}
                          alt={`${show.title} artwork`}
                          width="184"
                          height="184"
                          loading={featuredShows.indexOf(show) === 0 ? 'eager' : 'lazy'}
                          fetchpriority={featuredShows.indexOf(show) === 0 ? 'high' : 'auto'}
                          decoding="async"
                          class="show-row-art"
                        />
                      </picture>
                    </a>
                    <div class="show-row-meta">
                      <h3 class="show-row-heading">
                        {show.heading ?? show.subtitle ?? show.title}
                      </h3>
                      <p class="show-row-desc">{show.description}</p>
                      <a href={`${base}/shows/${show.id}/`} class="show-row-cta">
                        All Episodes →
                      </a>
                      <div class="show-row-platforms">
                        {show.spotifyUrl && (
                          <a href={show.spotifyUrl} target="_blank" rel="noopener noreferrer" class="show-platform-btn" aria-label={`Listen to ${show.title} on Spotify`}>
                            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                              <path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/>
                            </svg>
                            Spotify
                          </a>
                        )}
                        {show.applePodcastsUrl && (
                          <a href={show.applePodcastsUrl} target="_blank" rel="noopener noreferrer" class="show-platform-btn" aria-label={`Listen to ${show.title} on Apple Podcasts`}>
                            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                              <path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm0 18a8 8 0 1 1 8-8 8 8 0 0 1-8 8zm1-12.93V13a1 1 0 0 1-2 0V7.07A5 5 0 0 0 7 12a5 5 0 0 0 10 0 5 5 0 0 0-4-4.93zM12 15a1 1 0 1 1 1-1 1 1 0 0 1-1 1z"/>
                            </svg>
                            Apple Podcasts
                          </a>
                        )}
                      </div>
                    </div>
                  </div>

                  <!-- Latest episode -->
                  <div class="show-row-episode">
                    <p class="episode-eyebrow">Latest Episode</p>
                    {ep ? (
                      <>
                        <h4 class="episode-title">{ep.episode.title}</h4>
                        {ep.episode.pubDate && (
                          <p class="episode-date">
                            <time datetime={ep.episode.pubDate}>{formatDate(ep.episode.pubDate)}</time>
                          </p>
                        )}
                        {ep.episode.description && (
                          <p class="episode-desc">{ep.episode.description}</p>
                        )}
                        <div class="episode-listen-row">
                          <a
                            href={`${base}/shows/${show.id}/${ep.episode.slug}/`}
                            class="episode-listen-btn"
                          >
                            Listen Now
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/>
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                          </a>
                        </div>
                      </>
                    ) : (
                      <p class="show-row-desc" style="margin-top: 0.25rem;">New episodes coming soon.</p>
                    )}
                  </div>
                </li>
              );
            })}
          </ul>

          <!-- Link to see all German variants -->
          <div class="text-center mt-8">
            <p class="text-brand-secondary/50 text-sm mb-3">
              Also learning German? We have dedicated shows for Spanish, French, Italian & Turkish speakers.
            </p>
            <a
              href={`${base}/shows/#learn-german`}
              class="inline-flex items-center gap-2 text-brand-secondary/70 font-semibold text-sm border border-brand-secondary/20 px-5 py-2 rounded-full hover:border-brand-secondary/50 transition-colors"
            >
              Browse German Learning Shows
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
          </div>
        </div>
      </section>



    </main>

    <Footer />
  </div>
</BaseLayout>

<style>
  /* Show rows */
  .show-row {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    background: white;
    border-radius: 20px;
    border: 1.5px solid rgba(82, 62, 38, 0.08);
    padding: 1.5rem;
    box-shadow: 0 2px 12px rgba(82, 62, 38, 0.05);
  }
  @media (min-width: 1024px) {
    .show-row { flex-direction: row; align-items: flex-start; }
  }

  /* Left: show info */
  .show-row-left {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    flex-shrink: 0;
  }
  @media (min-width: 1024px) {
    .show-row-left { width: 42%; }
  }
  .show-row-art-link { flex-shrink: 0; }
  .show-row-art {
    width: 150px;
    height: 150px;
    border-radius: 14px;
    object-fit: cover;
    flex-shrink: 0;
  }
  @media (min-width: 640px) {
    .show-row-art { width: 184px; height: 184px; }
  }
  .show-row-meta {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .show-row-heading {
    font-family: var(--font-heading, 'Poppins', sans-serif);
    font-size: 1rem;
    font-weight: 700;
    color: #523E26;
    line-height: 1.3;
    margin: 0;
  }
  @media (min-width: 768px) {
    .show-row-heading { font-size: 1.0625rem; }
  }
  .show-row-desc {
    font-size: 0.8125rem;
    color: rgba(82, 62, 38, 0.65);
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .show-row-cta {
    font-size: 0.8125rem;
    font-weight: 700;
    color: #F39C12;
    text-decoration: none;
    margin-top: 0.25rem;
    align-self: flex-start;
  }
  .show-row-cta:hover { text-decoration: underline; }
  .episode-listen-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }
  .show-row-platforms {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }
  .show-platform-btn:hover { opacity: 0.85; }

  /* Right: latest episode */
  .show-row-episode {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(82, 62, 38, 0.08);
  }
  @media (min-width: 1024px) {
    .show-row-episode {
      flex: 1;
      padding-top: 0;
      padding-left: 1.5rem;
      border-top: none;
      border-left: 1px solid rgba(82, 62, 38, 0.1);
    }
  }
  .episode-eyebrow {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
    color: rgba(82, 62, 38, 0.45);
    margin: 0;
  }
  .episode-title {
    font-family: var(--font-heading, 'Poppins', sans-serif);
    font-size: 0.9375rem;
    font-weight: 700;
    color: #523E26;
    line-height: 1.35;
    margin: 0;
  }
  @media (min-width: 768px) {
    .episode-title { font-size: 1rem; }
  }
  .episode-date {
    font-size: 0.75rem;
    color: rgba(82, 62, 38, 0.5);
    margin: 0;
  }
  .episode-desc {
    font-size: 0.8125rem;
    color: rgba(82, 62, 38, 0.65);
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .episode-listen-btn,
  .show-platform-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    font-family: var(--font-heading, 'Poppins', sans-serif);
    font-weight: 700;
    font-size: 0.8125rem;
    padding: 0.5rem 1.125rem;
    border-radius: 9999px;
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.2s;
  }
  .episode-listen-btn {
    background: #F39C12;
    color: white;
    margin-top: 0.375rem;
    align-self: flex-start;
  }
  .show-platform-btn {
    background: #523E26;
    color: #F5F1E8;
  }
  .episode-listen-btn:hover,
  .show-platform-btn:hover { opacity: 0.85; }
</style>
