---
/**
 * Individual Show Page (Dynamic Route)
 *
 * Displays the show's embedded Castos player plus a full episode list
 * fetched from the show's RSS feed at build time. Episode links drive
 * powerful long-tail SEO traffic to individual episode pages.
 *
 * Route: /shows/[id]
 */

import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { siteConfig } from '@/config/site';
import { getShowEmbedUrl } from '@/utils/podcast';
import { fetchEpisodes, type RssEpisode } from '@/utils/rss';
import { formatDate } from '@/config/seo';

export async function getStaticPaths() {
  const paths = await Promise.all(
    siteConfig.shows.map(async (show) => {
      const episodes: RssEpisode[] = show.rssUrl ? await fetchEpisodes(show.rssUrl) : [];
      return { params: { id: show.id }, props: { episodes } };
    })
  );
  return paths;
}

const { id } = Astro.params;
const { episodes } = Astro.props as { episodes: RssEpisode[] };

const show = siteConfig.shows.find((s) => s.id === id);
if (!show) return Astro.redirect('/404');

const embedUrl =
  show.castosPlaylistUrl ||
  show.embedUrl ||
  getShowEmbedUrl(show.platform || 'apple', show.spotifyUrl, show.applePodcastsUrl);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// ── Season grouping ────────────────────────────────────────────────────────
// Castos auto-increments the season number on every upload after Season 2,
// producing spurious single-episode "seasons" (3, 4, 5 … 36).
// Rule: Season 2 is real. Everything else (seasons 1, 3-N, or untagged) is
// normalised to Season 1. "bonus" bucket is reserved for episodes with no tag.
const normalise = (raw: string | undefined): string => {
  if (!raw) return 'bonus';
  return raw === '2' ? '2' : '1';
};

const seasonMap = new Map<string, RssEpisode[]>();
for (const ep of episodes) {
  const key = normalise(ep.season);
  if (!seasonMap.has(key)) seasonMap.set(key, []);
  seasonMap.get(key)!.push(ep);
}
// Sort season keys: numbered seasons descending, "bonus" at the end
const sortedSeasonKeys = [...seasonMap.keys()].sort((a, b) => {
  if (a === 'bonus') return 1;
  if (b === 'bonus') return -1;
  return parseInt(b) - parseInt(a);
});
const seasons = sortedSeasonKeys.map((key) => ({
  key,
  label: key === 'bonus' ? 'Bonus / Specials' : `Season ${key}`,
  episodes: seasonMap.get(key)!,
}));
const hasSeasons = seasons.length > 1 || (seasons.length === 1 && seasons[0].key !== 'bonus');

const title = `${show.title}: ${show.subtitle} | ${siteConfig.brand.name}`;
const description = show.description;
---

<BaseLayout title={title} description={description}>
  <div class="min-h-screen flex flex-col bg-brand-background">
    <Header />
    
    <main class="flex-grow py-8 md:py-12">
      <div class="container-custom max-w-5xl mx-auto">
        <!-- Back Link -->
        <div class="mb-6">
          <a 
            href={`${base}/shows/`} 
            class="inline-flex items-center text-brand-secondary hover:opacity-70 transition-opacity text-sm md:text-base font-medium"
          >
            <svg class="w-4 h-4 md:w-5 md:h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            Back to All Shows
          </a>
        </div>

        <!-- Show Title and Description -->
        <div class="mb-8">
          <h1 class="text-3xl md:text-4xl font-normal text-brand-secondary mb-2">
            {show.title}
          </h1>
          {show.subtitle && (
            <h2 class="text-3xl md:text-4xl font-normal text-brand-secondary mb-4">
              {show.subtitle}
            </h2>
          )}
          <p class="text-lg text-brand-secondary/70 leading-relaxed">
            {show.description}
          </p>
        </div>

        <!-- Embedded Player -->
        <div class="player-container">
          <div class="player-inner">
            <iframe
              id="embedPlayer"
              src={embedUrl}
              width="100%"
              height="450"
              title="Media player"
              sandbox="allow-forms allow-popups allow-same-origin allow-scripts allow-top-navigation-by-user-activation"
              allow="autoplay *; encrypted-media *; clipboard-write"
              loading="eager"
              class="podcast-player"
            ></iframe>
          </div>
        </div>

        <!-- Show Website Button -->
        {show.showWebsiteUrl && (
          <div class="mt-8 flex justify-center">
            <a
              href={show.showWebsiteUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 bg-brand-secondary text-brand-background font-heading font-semibold px-5 py-2.5 rounded-full hover:opacity-85 transition-opacity text-sm md:text-base"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
              </svg>
              Show Website
            </a>
          </div>
        )}

        <!-- Episode List (from RSS feed, grouped by season) -->
        {episodes.length > 0 && (
          <section class="mt-16" aria-labelledby="episodes-heading">
            <h2 id="episodes-heading" class="text-2xl md:text-3xl font-bold text-brand-secondary mb-2">
              All Episodes
            </h2>
            <p class="text-brand-secondary/50 text-sm mb-8">
              {episodes.length} episode{episodes.length !== 1 ? 's' : ''}
              {hasSeasons && ` across ${seasons.filter(s => s.key !== 'bonus').length} season${seasons.filter(s => s.key !== 'bonus').length !== 1 ? 's' : ''}`}
            </p>

            {seasons.map((season, idx) => (
              <details class="season-block" open={idx === 0}>
                <summary class="season-header">
                  <h3 class="season-title">{season.label}</h3>
                  <span class="season-count">{season.episodes.length} episode{season.episodes.length !== 1 ? 's' : ''}</span>
                  <svg class="season-chevron" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                  </svg>
                </summary>
                <ol class="episode-list" reversed>
                  {season.episodes.map((ep) => (
                    <li class="episode-item">
                      <a
                        href={`${base}/shows/${id}/${ep.slug}/`}
                        class="episode-link group"
                      >
                        <div class="episode-meta">
                          {ep.episodeNumber && (
                            <span class="episode-number">Ep. {ep.episodeNumber}</span>
                          )}
                          <time class="episode-date" datetime={ep.pubDate}>
                            {formatDate(ep.pubDate)}
                          </time>
                          {ep.duration && (
                            <span class="episode-duration">{ep.duration}</span>
                          )}
                        </div>
                        <h4 class="episode-title group-hover:text-brand-accent transition-colors">
                          {ep.title}
                        </h4>
                        {ep.description && (
                          <p class="episode-desc">{ep.description}</p>
                        )}
                      </a>
                    </li>
                  ))}
                </ol>
              </details>
            ))}
          </section>
        )}
      </div>
    </main>
    
    <Footer />
  </div>
</BaseLayout>

<style>
  .player-container {
    background: linear-gradient(135deg, #fdf8f3 0%, #f5f1e8 100%);
    border-radius: 24px;
    padding: 2rem;
    box-shadow: 
      0 10px 15px -3px rgba(82, 62, 38, 0.15),
      0 4px 6px -2px rgba(82, 62, 38, 0.08),
      0 0 0 1px rgba(82, 62, 38, 0.06);
  }
  
  .player-inner {
    background: #ffffff;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.04);
  }
  
  .podcast-player {
    border: 0;
    display: block;
    width: 100%;
  }
  
  @media (max-width: 768px) {
    .player-container {
      padding: 1.25rem;
      border-radius: 20px;
    }
    
    .podcast-player {
      height: 450px !important;
    }
  }
  
  @media (min-width: 769px) {
    .podcast-player {
      height: 450px;
    }
  }

  /* Episode list styles */
  .episode-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .episode-item {
    border-top: 1px solid rgba(82, 62, 38, 0.1);
  }
  .episode-item:last-child {
    border-bottom: 1px solid rgba(82, 62, 38, 0.1);
  }

  .episode-link {
    display: block;
    padding: 1.25rem 0.5rem;
    text-decoration: none;
    color: inherit;
    transition: background 0.15s;
    border-radius: 8px;
  }
  .episode-link:hover {
    background: rgba(243, 156, 18, 0.06);
    padding-left: 1rem;
    padding-right: 1rem;
    margin-left: -0.5rem;
    margin-right: -0.5rem;
  }

  .episode-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.35rem;
    font-size: 0.75rem;
    color: rgba(82, 62, 38, 0.55);
    font-weight: 500;
  }

  .episode-number {
    background: rgba(82, 62, 38, 0.08);
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
  }

  .episode-title {
    font-size: 1rem;
    font-weight: 600;
    color: #523E26;
    margin: 0 0 0.25rem;
    line-height: 1.4;
  }

  .episode-desc {
    font-size: 0.875rem;
    color: rgba(82, 62, 38, 0.65);
    margin: 0;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ── Season grouping ────────────────────────────────────────────────── */
  .season-block {
    margin-bottom: 1rem;
    border: 1px solid rgba(82, 62, 38, 0.15);
    border-radius: 12px;
    overflow: hidden;
  }

  /* Remove browser default disclosure triangle */
  .season-block > summary {
    list-style: none;
  }
  .season-block > summary::-webkit-details-marker {
    display: none;
  }

  .season-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1.1rem;
    background: linear-gradient(135deg, #fdf8f3 0%, #f5f1e8 100%);
    cursor: pointer;
    user-select: none;
    transition: background 0.15s;
  }
  .season-header:hover {
    background: rgba(243, 156, 18, 0.1);
  }

  .season-title {
    font-family: "Poppins", "Helvetica Neue", sans-serif;
    font-size: 1rem;
    font-weight: 700;
    color: #523E26;
    margin: 0;
    letter-spacing: -0.01em;
    flex: 1;
  }

  .season-count {
    font-size: 0.75rem;
    color: rgba(82, 62, 38, 0.45);
    font-weight: 500;
    white-space: nowrap;
  }

  .season-chevron {
    width: 1.1rem;
    height: 1.1rem;
    color: rgba(82, 62, 38, 0.5);
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }
  .season-block[open] .season-chevron {
    transform: rotate(180deg);
  }

  /* Pad the episode list when open */
  .season-block[open] .episode-list {
    padding: 0 0.5rem 0.75rem;
  }
</style>
