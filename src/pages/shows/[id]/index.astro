---
/**
 * Individual Show Page (Dynamic Route)
 *
 * Displays the show's embedded Castos player plus a full episode list
 * fetched from the show's RSS feed at build time. Episode links drive
 * powerful long-tail SEO traffic to individual episode pages.
 *
 * Route: /shows/[id]
 */

import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { siteConfig } from '@/config/site';
import { getShowEmbedUrl } from '@/utils/podcast';
import { fetchEpisodes, type RssEpisode } from '@/utils/rss';
import { formatDate, generatePodcastSchema } from '@/config/seo';

export async function getStaticPaths() {
  const paths = await Promise.all(
    siteConfig.shows.map(async (show) => {
      const episodes: RssEpisode[] = show.rssUrl ? await fetchEpisodes(show.rssUrl) : [];
      return { params: { id: show.id }, props: { episodes } };
    })
  );
  return paths;
}

const { id } = Astro.params;
const { episodes } = Astro.props as { episodes: RssEpisode[] };

const show = siteConfig.shows.find((s) => s.id === id);
if (!show) return Astro.redirect('/404');

const embedUrl =
  show.castosPlaylistUrl ||
  show.embedUrl ||
  getShowEmbedUrl(show.platform || 'apple', show.spotifyUrl, show.applePodcastsUrl);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// ── Season grouping ────────────────────────────────────────────────────────
// Castos auto-increments the season number on every upload after Season 2,
// producing spurious single-episode "seasons" (3, 4, 5 … 36).
// Rule: Season 2 is real. Everything else (seasons 1, 3-N, or untagged) is
// normalised to Season 1. "bonus" bucket is reserved for episodes with no tag.
const normalise = (raw: string | undefined): string => {
  if (!raw) return 'bonus';
  return raw === '2' ? '2' : '1';
};

const seasonMap = new Map<string, RssEpisode[]>();
for (const ep of episodes) {
  const key = normalise(ep.season);
  if (!seasonMap.has(key)) seasonMap.set(key, []);
  seasonMap.get(key)!.push(ep);
}
// Sort season keys: numbered seasons descending, "bonus" at the end
const sortedSeasonKeys = [...seasonMap.keys()].sort((a, b) => {
  if (a === 'bonus') return 1;
  if (b === 'bonus') return -1;
  return parseInt(b) - parseInt(a);
});
const seasons = sortedSeasonKeys.map((key) => ({
  key,
  label: key === 'bonus' ? 'Bonus / Specials' : `Season ${key}`,
  episodes: seasonMap.get(key)!,
}));
const hasSeasons = seasons.length > 1 || (seasons.length === 1 && seasons[0].key !== 'bonus');

const title = `${show.title}: ${show.subtitle} | ${siteConfig.brand.name}`;
const description = show.description;
const showSchema = generatePodcastSchema(show, siteConfig.seo, { numberOfEpisodes: episodes.length });
// Show artwork as the OG/social share image for this show page
const showOgImage = show.artworkUrl.startsWith('http')
  ? show.artworkUrl
  : `${siteConfig.seo.siteUrl}/${show.artworkUrl.replace(/^\//, '')}`;

// hreflang: self-reference + x-default pointing to homepage
const hreflangLinks = [
  { lang: show.language || 'en', href: `${siteConfig.seo.siteUrl}/shows/${show.id}/` },
  { lang: 'x-default', href: `${siteConfig.seo.siteUrl}/` },
];
---

<BaseLayout
  title={title}
  description={description}
  ogImage={showOgImage}
  lang={show.language}
  locale={show.locale}
  hreflangLinks={hreflangLinks}
  rssFeedUrl={show.rssUrl}
  applePodcastsId={show.applePodcastsId}
  applePodcastsUrl={show.applePodcastsUrl}
>
  <script is:inline slot="head-extras" type="application/ld+json" set:html={JSON.stringify(showSchema)} />
  <div class="min-h-screen flex flex-col bg-brand-background">
    <Header />
    
    <main class="flex-grow py-8 md:py-12">
      <div class="container-custom max-w-5xl mx-auto">
        <!-- Back Link -->
        <div class="mb-6">
          <a 
            href={`${base}/shows/`} 
            class="inline-flex items-center text-brand-secondary hover:opacity-70 transition-opacity text-sm md:text-base font-medium"
          >
            <svg class="w-4 h-4 md:w-5 md:h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            Back to All Shows
          </a>
        </div>

        <!-- Show Title and Description -->
        <div class="mb-8">
          <h1 class="text-3xl md:text-4xl font-bold text-brand-secondary mb-4 leading-tight">
            {show.subtitle ? `${show.title}: ${show.subtitle}` : show.title}
          </h1>
          <p class="text-lg text-brand-secondary/70 leading-relaxed">
            {show.description}
          </p>
        </div>

        <!-- Embedded Player -->
        <div class="player-container">
          <div class="player-inner">
            <iframe
              id="embedPlayer"
              src={embedUrl}
              width="100%"
              height="175"
              title={`${show.title} - ${show.subtitle || 'Player'}`}
              allow="autoplay *; encrypted-media *; fullscreen *; clipboard-write"
              allowfullscreen
              loading="eager"
              class="podcast-player"
            ></iframe>
          </div>
        </div>

        <!-- Platform Listen & Website Buttons -->
        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
          {show.spotifyUrl && (
            <a
              href={show.spotifyUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="show-platform-btn"
              aria-label={`Listen to ${show.title} on Spotify`}
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/>
              </svg>
              <span>Spotify</span>
            </a>
          )}
          {show.applePodcastsUrl && (
            <a
              href={show.applePodcastsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="show-platform-btn"
              aria-label={`Listen to ${show.title} on Apple Podcasts`}
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm0 18a8 8 0 1 1 8-8 8 8 0 0 1-8 8zm1-12.93V13a1 1 0 0 1-2 0V7.07A5 5 0 0 0 7 12a5 5 0 0 0 10 0 5 5 0 0 0-4-4.93zM12 15a1 1 0 1 1 1-1 1 1 0 0 1-1 1z"/>
              </svg>
              <span>Apple Podcasts</span>
            </a>
          )}
          {show.showWebsiteUrl && (
            <a
              href={show.showWebsiteUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="show-platform-btn"
              aria-label={`Visit ${show.title} website`}
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
              </svg>
              <span>Show Website</span>
            </a>
          )}
        </div>

        <!-- Episode List (from RSS feed, grouped by season) -->
        {episodes.length > 0 && (
          <section class="mt-16" aria-labelledby="episodes-heading">
            <h2 id="episodes-heading" class="text-2xl md:text-3xl font-bold text-brand-secondary mb-2">
              All Episodes
            </h2>
            <p class="text-brand-secondary/50 text-sm mb-8">
              {episodes.length} episode{episodes.length !== 1 ? 's' : ''}
              {hasSeasons && ` across ${seasons.filter(s => s.key !== 'bonus').length} season${seasons.filter(s => s.key !== 'bonus').length !== 1 ? 's' : ''}`}
            </p>

            {seasons.map((season, idx) => (
              <details class="season-block" open={idx === 0}>
                <summary class="season-header">
                  <h3 class="season-title">{season.label}</h3>
                  <span class="season-count">{season.episodes.length} episode{season.episodes.length !== 1 ? 's' : ''}</span>
                  <svg class="season-chevron" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                  </svg>
                </summary>
                <ol class="episode-list" reversed>
                  {season.episodes.map((ep) => (
                    <li class="episode-item">
                      <a
                        href={`${base}/shows/${id}/${ep.slug}/`}
                        class="episode-link group"
                      >
                        <div class="episode-meta">
                          {ep.episodeNumber && (
                            <span class="episode-number">Ep. {ep.episodeNumber}</span>
                          )}
                          <time class="episode-date" datetime={ep.pubDate}>
                            {formatDate(ep.pubDate)}
                          </time>
                          {ep.duration && (
                            <span class="episode-duration">{ep.duration}</span>
                          )}
                        </div>
                        <h4 class="episode-title group-hover:text-brand-accent transition-colors">
                          {ep.title}
                        </h4>
                        {ep.description && (
                          <p class="episode-desc">{ep.description}</p>
                        )}
                      </a>
                    </li>
                  ))}
                </ol>
              </details>
            ))}
          </section>
        )}
      </div>
    </main>
    
    <Footer />
  </div>
</BaseLayout>

<style>
  .player-container {
    background: linear-gradient(135deg, #fdf8f3 0%, #f5f1e8 100%);
    border-radius: 24px;
    padding: 2rem;
    box-shadow: 
      0 10px 15px -3px rgba(82, 62, 38, 0.15),
      0 4px 6px -2px rgba(82, 62, 38, 0.08),
      0 0 0 1px rgba(82, 62, 38, 0.06);
    transition: background 0.3s ease, box-shadow 0.3s ease;
  }
  :global(html.dark) .player-container {
    background: linear-gradient(135deg, #251A0E 0%, #1C1208 100%);
    box-shadow: 
      0 10px 15px -3px rgba(0, 0, 0, 0.4),
      0 4px 6px -2px rgba(0, 0, 0, 0.2),
      0 0 0 1px var(--border);
  }
  
  .player-inner {
    width: 100%;
    background: transparent;
    border-radius: 14px;
    overflow: hidden;
  }

  /* Apple's compact (size=small) show card is a fixed ~175px tall at every width.
     Do NOT set color-scheme on this iframe: the embed is light-only, and a
     mismatch makes the browser paint an opaque white canvas behind it. */
  .podcast-player {
    border: 0;
    display: block;
    width: 100%;
    height: 175px;
    background: transparent;
    border-radius: 14px;
  }
  
  @media (max-width: 768px) {
    .player-container {
      padding: 1rem;
      border-radius: 20px;
    }
  }

  /* Episode list styles */
  .episode-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .episode-item {
    border-top: 1px solid var(--border);
    transition: border-color 0.3s ease;
  }
  .episode-item:last-child {
    border-bottom: 1px solid var(--border);
  }

  .episode-link {
    display: block;
    padding: 1.25rem 0.5rem;
    text-decoration: none;
    color: inherit;
    transition: background 0.15s;
    border-radius: 8px;
  }
  .episode-link:hover {
    background: rgba(194, 122, 68, 0.1);
    padding-left: 1rem;
    padding-right: 1rem;
    margin-left: -0.5rem;
    margin-right: -0.5rem;
  }

  .episode-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.35rem;
    font-size: 0.75rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .episode-number {
    background: var(--bg-subtle);
    color: var(--text);
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
  }
  :global(html.dark) .episode-number {
    background: var(--card);
    border: 1px solid var(--border);
  }

  .episode-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text);
    margin: 0 0 0.25rem;
    line-height: 1.4;
  }

  .episode-desc {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin: 0;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ── Season grouping ────────────────────────────────────────────────── */
  .season-block {
    margin-bottom: 1rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    transition: border-color 0.3s ease;
  }

  /* Remove browser default disclosure triangle */
  .season-block > summary {
    list-style: none;
  }
  .season-block > summary::-webkit-details-marker {
    display: none;
  }

  .season-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1.1rem;
    background: linear-gradient(135deg, #fdf8f3 0%, #f5f1e8 100%);
    cursor: pointer;
    user-select: none;
    transition: background 0.15s;
  }
  :global(html.dark) .season-header {
    background: linear-gradient(135deg, #251A0E 0%, #1C1208 100%);
  }
  .season-header:hover {
    background: rgba(194, 122, 68, 0.1);
  }
  :global(html.dark) .season-header:hover {
    background: rgba(176, 125, 90, 0.15);
  }

  .season-title {
    font-family: "Poppins", "Helvetica Neue", sans-serif;
    font-size: 1rem;
    font-weight: 700;
    color: var(--text);
    margin: 0;
    letter-spacing: -0.01em;
    flex: 1;
  }

  .season-count {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-weight: 500;
    white-space: nowrap;
  }

  .season-chevron {
    width: 1.1rem;
    height: 1.1rem;
    color: var(--text-muted);
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }
  .season-block[open] .season-chevron {
    transform: rotate(180deg);
  }

  /* Pad the episode list when open */
  .season-block[open] .episode-list {
    padding: 0 0.5rem 0.75rem;
  }
</style>
