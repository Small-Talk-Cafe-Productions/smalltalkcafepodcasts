---
/**
 * Shows Page
 * 
 * Displays all podcast shows with the same style as the featured show on the homepage.
 * Uses ShowDisplay component for consistent styling and maximum code reuse.
 */

import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ShowDisplay from '@/components/ShowDisplay.astro';
import PreplyBanner from '@/components/PreplyBanner.astro';
import { siteConfig } from '@/config/site';

const { shows, seo } = siteConfig;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// SEO metadata
const title = 'German Podcast Shows | Small Talk Café — Practice Speaking';
const description = 'Browse all Small Talk Café German podcast shows. Bite-sized episodes to build real speaking confidence — for English, Spanish, French & Italian speakers. On Spotify & Apple Podcasts.';

// Structured data: CollectionPage with the 4 shows
const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Small Talk Café — All Podcast Shows',
  description,
  url: `${seo.siteUrl}/shows/`,
  hasPart: shows.map((show) => ({
    '@type': 'PodcastSeries',
    name: show.subtitle ? `${show.title}: ${show.subtitle}` : show.title,
    description: show.description,
    url: `${seo.siteUrl}/shows/${show.id}/`,
  })),
};
---

<BaseLayout title={title} description={description}>
  <Fragment slot="head-extras">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
  </Fragment>
  <div class="min-h-screen flex flex-col">
    <Header />
    
    <main class="shows-page bg-brand-background flex-grow">
      <!-- Page Header -->
      <section class="py-12 bg-brand-background">
        <div class="container-custom text-center">
          <h1 class="text-4xl md:text-5xl font-bold text-brand-secondary mb-4">
            German Podcast Shows — Practice Speaking
          </h1>
          <p class="text-lg text-brand-secondary/80 max-w-2xl mx-auto">
            Bite-sized episodes designed to build real German speaking confidence.
            <br> Available for English, Spanish, French &amp; Italian speakers.
          </p>
        </div>
      </section>

      <!-- Preply Affiliate Banner -->
      <section class="pb-4 px-4" aria-label="Sponsored content">
        <div class="container-custom max-w-5xl mx-auto">
          <PreplyBanner />
        </div>
      </section>

      <!-- Shows Grid (2 columns) -->
      <section class="py-12 md:py-16">
        <div class="container-custom">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12">
            {shows.map((show) => (
              <div class="show-grid-item">
                <ShowDisplay 
                  show={show} 
                  showTitle={true} 
                  showDescription={true}
                  headingLevel="h2"
                  linkable={true}
                />
              </div>
            ))}
          </div>
          
          {shows.length === 0 && (
            <div class="text-center py-16">
              <p class="text-brand-secondary/80 text-lg">
                No shows available yet. Check back soon!
              </p>
            </div>
          )}
        </div>
      </section>
    </main>

      <!-- Shop Cross-link -->
      <section class="py-10 bg-brand-secondary" aria-labelledby="shop-xlink-heading">
        <div class="container-custom max-w-3xl mx-auto px-4 text-center">
          <h2 id="shop-xlink-heading" class="text-xl md:text-2xl font-bold text-brand-background mb-3">
            Love Small Talk Café? Wear It.
          </h2>
          <p class="text-brand-background/75 mb-6 text-sm md:text-base">
            Browse our German-learner merch — mugs, tees, tote bags, and more.
          </p>
          <a
            href={`${base}/shop/`}
            class="inline-flex items-center gap-2 bg-brand-background text-brand-secondary font-heading font-bold px-6 py-3 rounded-full hover:opacity-90 transition-opacity text-sm"
          >
            Visit the Shop
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
            </svg>
          </a>
        </div>
      </section>

    <Footer />
  </div>
</BaseLayout>

<style>
  .shows-page {
    min-height: auto;
  }
</style>
