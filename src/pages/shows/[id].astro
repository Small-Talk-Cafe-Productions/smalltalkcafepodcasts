---
/**
 * Individual Show Page (Dynamic Route)
 * 
 * Displays embedded podcast player for browsing and playing all episodes.
 * Minimalist design focused on the listening experience.
 * 
 * Route: /shows/[id]
 */

import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { siteConfig } from '@/config/site';
import { getShowEmbedUrl } from '@/utils/podcast';

// Get the show ID from the URL
const { id } = Astro.params;

// Find the show in the configuration
const show = siteConfig.shows.find((s) => s.id === id);

// If show not found, return 404
if (!show) {
  return Astro.redirect('/404');
}

// Get embed URL (prioritize Castos, fallback to auto-generated from platform URLs)
const embedUrl = show.castosPlaylistUrl || show.embedUrl || getShowEmbedUrl(show.platform || 'apple', show.spotifyUrl, show.applePodcastsUrl);

// Get base URL (remove trailing slash for consistency)
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// SEO metadata
const title = `${show.title} | ${siteConfig.brand.name}`;
const description = show.description;

// Get static paths for build-time generation
export async function getStaticPaths() {
  const { siteConfig } = await import('@/config/site');
  
  return siteConfig.shows.map((show) => ({
    params: { id: show.id },
  }));
}
---

<BaseLayout title={title} description={description}>
  <div class="min-h-screen flex flex-col bg-brand-background">
    <Header />
    
    <main class="flex-grow py-8 md:py-12">
      <div class="container-custom max-w-5xl mx-auto">
        <!-- Back Link -->
        <div class="mb-6">
          <a 
            href={`${base}/shows`} 
            class="inline-flex items-center text-brand-secondary hover:opacity-70 transition-opacity text-sm md:text-base font-medium"
          >
            <svg class="w-4 h-4 md:w-5 md:h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            Back to All Shows
          </a>
        </div>

        <!-- Show Title and Description -->
        <div class="mb-8">
          <h2 class="text-3xl md:text-4xl font-normal text-brand-secondary mb-2">
            {show.title}
          </h2>
          {show.subtitle && (
            <h3 class="text-3xl md:text-4xl font-normal text-brand-secondary mb-4">
              {show.subtitle}
            </h3>
          )}
          <p class="text-lg text-brand-secondary/70 leading-relaxed">
            {show.description}
          </p>
        </div>

        <!-- Embedded Player -->
        <div class="player-container">
          <div class="player-inner">
            <iframe
              id="embedPlayer"
              src={embedUrl}
              width="100%"
              height="450"
              title="Media player"
              sandbox="allow-forms allow-popups allow-same-origin allow-scripts allow-top-navigation-by-user-activation"
              allow="autoplay *; encrypted-media *; clipboard-write"
              loading="eager"
              class="podcast-player"
            ></iframe>
          </div>
        </div>
      </div>
    </main>
    
    <Footer />
  </div>
</BaseLayout>

<style>
  .player-container {
    background: linear-gradient(135deg, #fdf8f3 0%, #f5f1e8 100%);
    border-radius: 24px;
    padding: 2rem;
    box-shadow: 
      0 10px 15px -3px rgba(82, 62, 38, 0.15),
      0 4px 6px -2px rgba(82, 62, 38, 0.08),
      0 0 0 1px rgba(82, 62, 38, 0.06);
  }
  
  .player-inner {
    background: #ffffff;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.04);
  }
  
  .podcast-player {
    border: 0;
    display: block;
    width: 100%;
  }
  
  @media (max-width: 768px) {
    .player-container {
      padding: 1.25rem;
      border-radius: 20px;
    }
    
    .podcast-player {
      height: 450px !important;
    }
  }
  
  @media (min-width: 769px) {
    .podcast-player {
      height: 450px;
    }
  }
</style>
