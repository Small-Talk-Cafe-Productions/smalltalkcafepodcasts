---
/**
 * About Page
 *
 * Business identity page required by Google's Misrepresentation policy.
 * Explains who we are, where we're based, and our business model.
 */

import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = 'About Us | Small Talk Café Productions';
const description =
  'Small Talk Café Productions is a Munich-based podcast network helping language learners build real speaking confidence in Spanish, French, Italian, Portuguese, Dutch, Swedish, Japanese, Korean, Mandarin, and German through bite-sized daily conversations.';
---

<BaseLayout title={title} description={description}>
  <div class="min-h-screen flex flex-col bg-brand-background">
    <Header />

    <main class="flex-grow">

      <!-- Hero -->
      <section class="py-10 md:py-16 px-4">
        <div class="container-custom max-w-3xl mx-auto">
          <h1 class="text-4xl md:text-5xl font-bold text-brand-secondary mb-6 leading-tight">
            About Small Talk Café
          </h1>
          <p class="text-brand-secondary/70 text-lg md:text-xl leading-relaxed">
            We make language learning approachable — one short conversation at a time.
          </p>
        </div>
      </section>

      <!-- Who We Are -->
      <section class="py-6 md:py-10 px-4 border-t border-brand-secondary/10">
        <div class="container-custom max-w-3xl mx-auto">
          <h2 class="text-2xl md:text-3xl font-bold text-brand-secondary mb-4">Who We Are</h2>
          <p class="text-brand-secondary/80 leading-relaxed mb-4">
            Small Talk Café Productions is an independent podcast network based in <strong>Munich, Germany</strong>.
            We create bite-sized language learning podcasts (including Spanish, French, Italian, Portuguese, Dutch, Swedish, Japanese, Korean, Mandarin, and German)
            for learners who want to pick up real conversational skills — without memorising endless grammar
            tables or sitting through long lectures.
          </p>
          <p class="text-brand-secondary/80 leading-relaxed">
            Our shows are available free on <strong>Spotify</strong> and <strong>Apple Podcasts</strong>, with new
            episodes published every day.
          </p>
        </div>
      </section>

      <!-- Our Mission -->
      <section class="py-6 md:py-10 px-4 border-t border-brand-secondary/10">
        <div class="container-custom max-w-3xl mx-auto">
          <h2 class="text-2xl md:text-3xl font-bold text-brand-secondary mb-4">Our Mission</h2>
          <p class="text-brand-secondary/80 leading-relaxed mb-4">
            Speaking a new language should feel like a conversation over coffee — not a grammar exam.
            We believe that the quickest path to speaking a new language is to hear real conversations in
            context, over and over, in manageable chunks.
          </p>
          <p class="text-brand-secondary/80 leading-relaxed">
            Every episode is designed to fit into a short commute, a lunch break, or a few minutes before
            bed. No textbook needed. No prior knowledge required.
          </p>
        </div>
      </section>

      <!-- Our Business Model -->
      <section class="py-6 md:py-10 px-4 border-t border-brand-secondary/10">
        <div class="container-custom max-w-3xl mx-auto">
          <h2 class="text-2xl md:text-3xl font-bold text-brand-secondary mb-4">How We Operate</h2>
          <div class="grid md:grid-cols-2 gap-6">
            <div class="bg-white rounded-2xl p-6 shadow-sm border border-brand-secondary/10">
              <h3 class="text-lg font-bold text-brand-secondary mb-2">Free Podcasts</h3>
              <p class="text-brand-secondary/70 leading-relaxed text-sm">
                All our podcast episodes are completely free to listen to on Spotify and Apple Podcasts.
                We publish new episodes every day so there is always fresh content to practice with.
              </p>
            </div>
            <div class="bg-white rounded-2xl p-6 shadow-sm border border-brand-secondary/10">
              <h3 class="text-lg font-bold text-brand-secondary mb-2">Merchandise Shop</h3>
              <p class="text-brand-secondary/70 leading-relaxed text-sm">
                Our online shop at <a href="https://smalltalkcafe.shop" target="_blank" rel="noopener noreferrer" class="underline hover:opacity-70">smalltalkcafe.shop</a> sells
                language learner merchandise — mugs, t-shirts, tote bags and more.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Where We Are Based -->
      <section class="py-6 md:py-10 px-4 border-t border-brand-secondary/10">
        <div class="container-custom max-w-3xl mx-auto">
          <h2 class="text-2xl md:text-3xl font-bold text-brand-secondary mb-4">Where We Are Based</h2>
          <p class="text-brand-secondary/80 leading-relaxed">
            Small Talk Café Productions is based in <strong>Munich, Germany</strong>.
            Our address is Kistlerhof Straße 84, Munich 81379.
          </p>
        </div>
      </section>

      <!-- Contact CTA -->
      <section class="py-10 md:py-14 px-4 border-t border-brand-secondary/10">
        <div class="container-custom max-w-3xl mx-auto text-center">
          <h2 class="text-2xl font-bold text-brand-secondary mb-4">Get in Touch</h2>
          <p class="text-brand-secondary/70 mb-6">
            Questions, feedback, or collab ideas? We'd love to hear from you.
          </p>
          <a
            href={`${base}/contact/`}
            class="inline-flex items-center gap-2 bg-brand-secondary text-brand-background font-heading font-bold px-7 py-3.5 rounded-full hover:opacity-85 transition-opacity text-base"
          >
            Contact Us
          </a>
        </div>
      </section>

    </main>

    <Footer />
  </div>
</BaseLayout>
