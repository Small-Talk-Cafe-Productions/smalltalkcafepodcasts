---
/**
 * 404 Not Found Page
 *
 * Rendered when a route or resource does not exist.
 * Fully styled for both light and dark themes.
 */

import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = '404 - Page Not Found | Small Talk Café';
const description = 'The page you are looking for does not exist or has been moved. Explore our language learning podcasts.';
---

<BaseLayout title={title} description={description}>
  <div class="min-h-screen flex flex-col bg-brand-background">
    <Header />

    <main class="flex-grow flex items-center justify-center py-20 px-4">
      <div class="container-custom max-w-xl mx-auto text-center">
        <p class="text-6xl mb-6" aria-hidden="true">☕</p>

        <span class="inline-block px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider mb-4 cafe-badge">
          404 Error
        </span>

        <h1 class="text-4xl md:text-5xl font-bold text-brand-secondary leading-tight mb-4">
          Page Not Found
        </h1>

        <p class="text-brand-secondary/70 leading-relaxed text-base md:text-lg mb-8 max-w-md mx-auto">
          We couldn't find the page you were looking for. It might have been moved or doesn't exist anymore.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href={`${base}/`}
            class="inline-flex items-center justify-center gap-2 bg-brand-secondary text-brand-background font-heading font-bold px-7 py-3.5 rounded-full hover:opacity-85 transition-opacity text-base shadow-sm"
          >
            Go to Homepage
          </a>
          <a
            href={`${base}/shows/`}
            class="inline-flex items-center justify-center gap-2 border-2 border-brand-secondary text-brand-secondary font-heading font-bold px-7 py-3.5 rounded-full hover:opacity-80 transition-opacity text-base"
          >
            Browse All Shows
          </a>
        </div>
      </div>
    </main>

    <Footer />
  </div>
</BaseLayout>
