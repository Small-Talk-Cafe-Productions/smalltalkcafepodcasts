---
/**
 * Privacy Policy Page
 *
 * Required by Google Merchant Center and GDPR (EU regulation).
 * Must be publicly accessible and linked from every page footer.
 */

import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

const title = 'Privacy Policy | Small Talk Café Productions';
const description = 'Privacy Policy for smalltalkcafe.de — how we collect, use, and protect your personal data.';
const lastUpdated = 'April 2026';
---

<BaseLayout title={title} description={description}>
  <div class="min-h-screen flex flex-col bg-brand-background">
    <Header />

    <main class="flex-grow">
      <section class="py-10 md:py-16 px-4">
        <div class="container-custom max-w-3xl mx-auto prose prose-sm md:prose-base text-brand-secondary">

          <h1 class="text-4xl font-bold text-brand-secondary mb-2">Privacy Policy</h1>
          <p class="text-brand-secondary/50 text-sm mb-8">Last updated: {lastUpdated}</p>

          <h2 class="text-xl font-bold text-brand-secondary mt-8 mb-3">1. Who We Are</h2>
          <p class="text-brand-secondary/80 leading-relaxed mb-4">
            Small Talk Café Productions operates the website <strong>smalltalkcafe.de</strong> and the
            online shop at <strong>smalltalkcafe.shop</strong>. We are based in Munich, Germany.
            For data protection enquiries contact us at:
            <a href="mailto:smalltalkcafe.productions@gmail.com" class="underline hover:opacity-70">smalltalkcafe.productions@gmail.com</a>.
          </p>

          <h2 class="text-xl font-bold text-brand-secondary mt-8 mb-3">2. Data We Collect</h2>
          <p class="text-brand-secondary/80 leading-relaxed mb-2">We may collect the following data:</p>
          <ul class="list-disc list-inside text-brand-secondary/80 space-y-1 mb-4">
            <li><strong>Website analytics:</strong> anonymised page-view data (pages visited, browser type, approximate country) via Google Analytics 4. No personally identifiable information is stored.</li>
            <li><strong>Shop purchases:</strong> name, email address, shipping address, and payment information when you purchase from our Shopify store. Payment data is processed securely by Shopify and is never stored on our servers.</li>
            <li><strong>Email enquiries:</strong> your email address and any information you voluntarily provide when contacting us.</li>
          </ul>

          <h2 class="text-xl font-bold text-brand-secondary mt-8 mb-3">3. How We Use Your Data</h2>
          <ul class="list-disc list-inside text-brand-secondary/80 space-y-1 mb-4">
            <li>To process and fulfil orders placed through our shop.</li>
            <li>To respond to enquiries you send us by email.</li>
            <li>To understand how our website is used so we can improve it (Google Analytics 4, in anonymised form).</li>
            <li>To comply with legal obligations (e.g. tax records for commercial transactions).</li>
          </ul>
          <p class="text-brand-secondary/80 leading-relaxed mb-4">
            We do <strong>not</strong> sell, rent, or share your personal data with third parties for marketing purposes.
          </p>

          <h2 class="text-xl font-bold text-brand-secondary mt-8 mb-3">4. Cookies</h2>
          <p class="text-brand-secondary/80 leading-relaxed mb-4">
            This website uses cookies to measure traffic via Google Analytics 4. Google Analytics sets cookies
            to distinguish users and sessions. You can opt out of Google Analytics tracking by installing the
            <a href="https://tools.google.com/dlpage/gaoptout" target="_blank" rel="noopener noreferrer" class="underline hover:opacity-70">Google Analytics opt-out browser add-on</a>.
          </p>

          <h2 class="text-xl font-bold text-brand-secondary mt-8 mb-3">5. Third-Party Services</h2>
          <ul class="list-disc list-inside text-brand-secondary/80 space-y-1 mb-4">
            <li><strong>Shopify</strong> — powers our online shop and processes payments. Shopify's privacy policy: <a href="https://www.shopify.com/legal/privacy" target="_blank" rel="noopener noreferrer" class="underline hover:opacity-70">shopify.com/legal/privacy</a>.</li>
            <li><strong>Google Analytics 4</strong> — anonymised website analytics. Google's privacy policy: <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer" class="underline hover:opacity-70">policies.google.com/privacy</a>.</li>
            <li><strong>Castos</strong> — hosts our podcast audio and RSS feeds. Castos' privacy policy: <a href="https://castos.com/privacy-policy/" target="_blank" rel="noopener noreferrer" class="underline hover:opacity-70">castos.com/privacy-policy</a>.</li>
          </ul>

          <h2 class="text-xl font-bold text-brand-secondary mt-8 mb-3">6. Data Retention</h2>
          <p class="text-brand-secondary/80 leading-relaxed mb-4">
            Order data is retained for the period required by German commercial and tax law (Handelsgesetzbuch / Abgabenordnung),
            typically 10 years. Analytics data is retained in its anonymised form for 14 months, after which it is
            automatically deleted by Google Analytics.
          </p>

          <h2 class="text-xl font-bold text-brand-secondary mt-8 mb-3">7. Your Rights (GDPR)</h2>
          <p class="text-brand-secondary/80 leading-relaxed mb-2">
            If you are located in the European Economic Area you have the right to:
          </p>
          <ul class="list-disc list-inside text-brand-secondary/80 space-y-1 mb-4">
            <li>Access the personal data we hold about you.</li>
            <li>Correct inaccurate data.</li>
            <li>Request deletion of your data ("right to be forgotten"), subject to legal retention obligations.</li>
            <li>Object to or restrict our processing of your data.</li>
            <li>Lodge a complaint with your national data protection authority.</li>
          </ul>
          <p class="text-brand-secondary/80 leading-relaxed mb-4">
            To exercise any of these rights, contact us at
            <a href="mailto:smalltalkcafe.productions@gmail.com" class="underline hover:opacity-70">smalltalkcafe.productions@gmail.com</a>.
          </p>

          <h2 class="text-xl font-bold text-brand-secondary mt-8 mb-3">8. Changes to This Policy</h2>
          <p class="text-brand-secondary/80 leading-relaxed mb-4">
            We may update this Privacy Policy from time to time. The "Last updated" date at the top of this page
            will reflect any changes. Continued use of our website after an update constitutes your acceptance
            of the revised policy.
          </p>

          <h2 class="text-xl font-bold text-brand-secondary mt-8 mb-3">9. Contact</h2>
          <p class="text-brand-secondary/80 leading-relaxed">
            Questions about this policy or your data?
            Email us at <a href="mailto:smalltalkcafe.productions@gmail.com" class="underline hover:opacity-70">smalltalkcafe.productions@gmail.com</a>.
          </p>

        </div>
      </section>
    </main>

    <Footer />
  </div>
</BaseLayout>
