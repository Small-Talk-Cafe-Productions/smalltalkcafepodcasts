---
/**
 * Contact Page
 *
 * Provides a clear way for customers to reach us — required by Google's
 * Misrepresentation policy to demonstrate business transparency.
 */

import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { siteConfig } from '@/config/site';

const { socialLinks } = siteConfig;

const title = 'Contact Us | Small Talk Café Productions';
const description =
  'Get in touch with Small Talk Café Productions — questions about our podcasts, merchandise orders, or anything else.';
---

<BaseLayout title={title} description={description}>
  <div class="min-h-screen flex flex-col bg-brand-background">
    <Header />

    <main class="flex-grow">

      <!-- Header -->
      <section class="py-10 md:py-16 px-4">
        <div class="container-custom max-w-2xl mx-auto">
          <h1 class="text-4xl md:text-5xl font-bold text-brand-secondary mb-6 leading-tight">
            Contact Us
          </h1>
          <p class="text-brand-secondary/70 text-lg leading-relaxed">
            We'd love to hear from you. Reach out via email or find us on social media below.
          </p>
        </div>
      </section>

      <!-- Contact Details -->
      <section class="py-6 md:py-10 px-4 border-t border-brand-secondary/10">
        <div class="container-custom max-w-2xl mx-auto">
          <div class="grid md:grid-cols-2 gap-6">

            <!-- Email -->
            <div class="bg-white rounded-2xl p-6 shadow-sm border border-brand-secondary/10">
              <div class="flex items-center gap-3 mb-3">
                <svg class="w-5 h-5 text-brand-secondary/60 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
                <h2 class="text-base font-bold text-brand-secondary">Email</h2>
              </div>
              <p class="text-brand-secondary/70 text-sm mb-3">
                For questions about our podcasts, shop orders, or general enquiries:
              </p>
              <a
                href="mailto:smalltalkcafe.productions@gmail.com"
                class="text-brand-secondary font-semibold underline underline-offset-2 hover:opacity-70 transition-opacity break-all"
              >
                smalltalkcafe.productions@gmail.com
              </a>
              <p class="text-brand-secondary/50 text-xs mt-3">
                We aim to respond within 2 business days.
              </p>
            </div>

            <!-- Location -->
            <div class="bg-white rounded-2xl p-6 shadow-sm border border-brand-secondary/10">
              <div class="flex items-center gap-3 mb-3">
                <svg class="w-5 h-5 text-brand-secondary/60 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                <h2 class="text-base font-bold text-brand-secondary">Location</h2>
              </div>
              <p class="text-brand-secondary/70 text-sm leading-relaxed">
                Kistlerhof Straße 84<br />
                Munich 81379<br />
                Germany
              </p>
            </div>

          </div>
        </div>
      </section>

      <!-- Social / Follow -->
      <section class="py-6 md:py-10 px-4 border-t border-brand-secondary/10">
        <div class="container-custom max-w-2xl mx-auto">
          <h2 class="text-xl font-bold text-brand-secondary mb-4">Follow Us</h2>
          <div class="flex flex-wrap gap-4">
            <a
              href={socialLinks.instagram}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 bg-white border border-brand-secondary/10 text-brand-secondary font-semibold px-5 py-2.5 rounded-full hover:opacity-80 transition-opacity text-sm shadow-sm"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
              Instagram
            </a>
            <a
              href={socialLinks.youtube}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 bg-white border border-brand-secondary/10 text-brand-secondary font-semibold px-5 py-2.5 rounded-full hover:opacity-80 transition-opacity text-sm shadow-sm"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
              YouTube
            </a>
          </div>
        </div>
      </section>

      <!-- Shop Support -->
      <section class="py-6 md:py-10 px-4 border-t border-brand-secondary/10">
        <div class="container-custom max-w-2xl mx-auto">
          <h2 class="text-xl font-bold text-brand-secondary mb-3">Shop & Order Enquiries</h2>
          <p class="text-brand-secondary/70 leading-relaxed text-sm">
            For questions about a specific order, shipping, or returns, please email us at
            <a href="mailto:smalltalkcafe.productions@gmail.com" class="underline hover:opacity-70">smalltalkcafe.productions@gmail.com</a>
            with your order number.
          </p>
        </div>
      </section>

    </main>

    <Footer />
  </div>
</BaseLayout>
