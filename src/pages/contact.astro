---
/**
 * Contact Page
 *
 * Clean, listener-focused contact page with an interactive message form,
 * direct email link, and social channels. No physical address or e-commerce references.
 */

import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { siteConfig } from '@/config/site';

const { socialLinks } = siteConfig;

const title = 'Contact Us | Small Talk Café Podcasts';
const description =
  'Get in touch with Small Talk Café Podcasts — feedback on our episodes, show suggestions, or collaboration inquiries.';
---

<BaseLayout title={title} description={description}>
  <div class="min-h-screen flex flex-col transition-colors duration-300" style="background-color:var(--bg); color:var(--text);">
    <Header />

    <main class="flex-grow">

      <!-- Header Hero -->
      <section class="py-10 md:py-16 px-4">
        <div class="container-custom max-w-4xl mx-auto text-center sm:text-left">
          <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold font-heading mb-4 leading-tight" style="color:var(--text);">
            Contact Us
          </h1>
          <p class="text-base sm:text-lg max-w-2xl leading-relaxed" style="color:var(--text-muted);">
            Have feedback on an episode, a language you’d love us to cover, or a partnership inquiry?
            Drop us a message below or reach out directly.
          </p>
        </div>
      </section>

      <!-- Main Contact Section -->
      <section class="pb-16 px-4">
        <div class="container-custom max-w-4xl mx-auto">
          <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start">

            <!-- Left column: Quick Contact Details (5 cols) -->
            <div class="md:col-span-5 space-y-6">

              <!-- Email Card -->
              <div class="rounded-2xl p-6 border shadow-sm transition-colors duration-300" style="background-color:var(--card); border-color:var(--border);">
                <div class="flex items-center gap-3 mb-3">
                  <div class="w-10 h-10 rounded-xl flex items-center justify-center" style="background-color:var(--bg-subtle); color:var(--amber);">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                    </svg>
                  </div>
                  <div>
                    <h2 class="text-base font-bold font-heading" style="color:var(--text);">Direct Email</h2>
                    <p class="text-xs" style="color:var(--text-muted);">We typically reply within 1–2 days</p>
                  </div>
                </div>
                <p class="text-sm mb-3" style="color:var(--text-muted);">
                  For listener feedback, questions, or collaborations:
                </p>
                <a
                  href="mailto:smalltalkcafe.productions@gmail.com"
                  class="font-semibold underline underline-offset-2 hover:opacity-80 transition-opacity break-all text-sm block"
                  style="color:var(--amber);"
                >
                  smalltalkcafe.productions@gmail.com
                </a>
                <div class="mt-3 pt-3 border-t flex items-center gap-2 text-xs" style="border-color:var(--border); color:var(--text-muted);">
                  <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                  <span>Based in Munich, Germany</span>
                </div>
              </div>

              <!-- Social Links Card -->
              <div class="rounded-2xl p-6 border shadow-sm transition-colors duration-300" style="background-color:var(--card); border-color:var(--border);">
                <h2 class="text-base font-bold font-heading mb-2" style="color:var(--text);">Follow Our Journey</h2>
                <p class="text-sm mb-4" style="color:var(--text-muted);">
                  Connect with us on social media for daily tips, behind-the-scenes, and show announcements:
                </p>
                <div class="flex flex-col gap-2.5">
                  <a
                    href={socialLinks.instagram}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-3 px-4 py-2.5 rounded-xl border text-sm font-semibold hover:opacity-80 transition-all"
                    style="background-color:var(--bg-subtle); border-color:var(--border); color:var(--text);"
                  >
                    <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                    </svg>
                    <span>Instagram</span>
                  </a>
                  <a
                    href={socialLinks.youtube}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-3 px-4 py-2.5 rounded-xl border text-sm font-semibold hover:opacity-80 transition-all"
                    style="background-color:var(--bg-subtle); border-color:var(--border); color:var(--text);"
                  >
                    <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                    </svg>
                    <span>YouTube Channel</span>
                  </a>
                </div>
              </div>

            </div>

            <!-- Right column: Drop a Message Form (7 cols) -->
            <div class="md:col-span-7">
              <div class="rounded-2xl p-6 sm:p-8 border shadow-sm transition-colors duration-300" style="background-color:var(--card); border-color:var(--border);">
                <div class="mb-6">
                  <h2 class="text-2xl font-bold font-heading mb-2" style="color:var(--text);">
                    Drop Us a Message
                  </h2>
                  <p class="text-sm" style="color:var(--text-muted);">
                    Fill in the form below and we’ll get back to you directly.
                  </p>
                </div>

                <form id="contact-form" class="space-y-4">
                  <!-- Name -->
                  <div>
                    <label for="name" class="block text-xs font-semibold uppercase tracking-wider mb-1.5" style="color:var(--text-muted);">
                      Your Name <span class="text-red-500">*</span>
                    </label>
                    <input
                      type="text"
                      id="name"
                      name="name"
                      required
                      placeholder="e.g. Maria"
                      class="w-full px-4 py-3 rounded-xl border text-sm transition-all focus:outline-none focus:ring-2"
                      style="background-color:var(--input-bg); border-color:var(--input-border); color:var(--text);"
                    />
                  </div>

                  <!-- Email -->
                  <div>
                    <label for="email" class="block text-xs font-semibold uppercase tracking-wider mb-1.5" style="color:var(--text-muted);">
                      Your Email <span class="text-red-500">*</span>
                    </label>
                    <input
                      type="email"
                      id="email"
                      name="email"
                      required
                      placeholder="e.g. maria@example.com"
                      class="w-full px-4 py-3 rounded-xl border text-sm transition-all focus:outline-none focus:ring-2"
                      style="background-color:var(--input-bg); border-color:var(--input-border); color:var(--text);"
                    />
                  </div>

                  <!-- Topic -->
                  <div>
                    <label for="topic" class="block text-xs font-semibold uppercase tracking-wider mb-1.5" style="color:var(--text-muted);">
                      Topic
                    </label>
                    <select
                      id="topic"
                      name="topic"
                      class="w-full px-4 py-3 rounded-xl border text-sm transition-all focus:outline-none focus:ring-2 cursor-pointer"
                      style="background-color:var(--input-bg); border-color:var(--input-border); color:var(--text);"
                    >
                      <option value="Episode Feedback">Episode Feedback</option>
                      <option value="Language / Show Request">Language / Show Request</option>
                      <option value="Collaboration or Sponsorship">Collaboration or Sponsorship</option>
                      <option value="General Question">General Question</option>
                    </select>
                  </div>

                  <!-- Message -->
                  <div>
                    <label for="message" class="block text-xs font-semibold uppercase tracking-wider mb-1.5" style="color:var(--text-muted);">
                      Message <span class="text-red-500">*</span>
                    </label>
                    <textarea
                      id="message"
                      name="message"
                      required
                      rows="5"
                      placeholder="Tell us what's on your mind..."
                      class="w-full px-4 py-3 rounded-xl border text-sm transition-all focus:outline-none focus:ring-2 resize-y"
                      style="background-color:var(--input-bg); border-color:var(--input-border); color:var(--text);"
                    ></textarea>
                  </div>

                  <!-- Submit button -->
                  <div class="pt-2">
                    <button
                      type="submit"
                      id="submit-btn"
                      class="w-full sm:w-auto inline-flex items-center justify-center gap-2 font-heading font-bold px-7 py-3 rounded-xl transition-all shadow-sm cursor-pointer"
                      style="background-color:var(--amber); color:#FFFFFF;"
                    >
                      <span id="btn-text">Send Message</span>
                      <svg id="btn-icon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                      </svg>
                    </button>
                  </div>

                  <!-- In-page status message -->
                  <div
                    id="form-status"
                    class="hidden p-4 rounded-xl text-sm leading-relaxed mt-4 transition-all"
                  ></div>
                </form>

              </div>
            </div>

          </div>
        </div>
      </section>

    </main>

    <Footer />
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const statusDiv = document.getElementById('form-status') as HTMLDivElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const btnText = document.getElementById('btn-text') as HTMLSpanElement | null;

  if (form && statusDiv && submitBtn && btnText) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const name = (document.getElementById('name') as HTMLInputElement)?.value.trim();
      const email = (document.getElementById('email') as HTMLInputElement)?.value.trim();
      const topic = (document.getElementById('topic') as HTMLSelectElement)?.value;
      const message = (document.getElementById('message') as HTMLTextAreaElement)?.value.trim();

      if (!name || !email || !message) {
        showStatus('Please fill in all required fields.', false);
        return;
      }

      btnText.textContent = 'Sending...';
      submitBtn.disabled = true;
      submitBtn.style.opacity = '0.7';

      try {
        const response = await fetch('https://formsubmit.co/ajax/smalltalkcafe.productions@gmail.com', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
          },
          body: JSON.stringify({
            name,
            email,
            _subject: `[Small Talk Café Contact] ${topic} from ${name}`,
            topic,
            message,
          }),
        });

        if (response.ok) {
          form.reset();
          showStatus(
            '✓ Thank you! Your message has been sent successfully. We will get back to you soon.',
            true
          );
        } else {
          // If service responds with an error, offer mailto fallback
          fallbackToMailto(name, email, topic, message);
        }
      } catch (err) {
        // Network or adblocker failure fallback
        fallbackToMailto(name, email, topic, message);
      } finally {
        btnText.textContent = 'Send Message';
        submitBtn.disabled = false;
        submitBtn.style.opacity = '1';
      }
    });

    function showStatus(text: string, isSuccess: boolean) {
      if (!statusDiv) return;
      statusDiv.className = isSuccess
        ? 'p-4 rounded-xl text-sm leading-relaxed mt-4 bg-green-500/10 border border-green-500/30 text-green-700 dark:text-green-300 block'
        : 'p-4 rounded-xl text-sm leading-relaxed mt-4 bg-red-500/10 border border-red-500/30 text-red-700 dark:text-red-300 block';
      statusDiv.textContent = text;
    }

    function fallbackToMailto(name: string, email: string, topic: string, message: string) {
      const subject = encodeURIComponent(`[Small Talk Café] ${topic} - ${name}`);
      const body = encodeURIComponent(`From: ${name} (${email})\n\nTopic: ${topic}\n\nMessage:\n${message}`);
      window.location.href = `mailto:smalltalkcafe.productions@gmail.com?subject=${subject}&body=${body}`;
      showStatus(
        'Opening your email app to send the message directly to smalltalkcafe.productions@gmail.com...',
        true
      );
    }
  }
</script>
