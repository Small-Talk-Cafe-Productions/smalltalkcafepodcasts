---
/**
 * ShowPlayer Component
 *
 * A large, theme-aware podcast player for the show page: show artwork and a
 * "Latest Episode" button on the left, a scrollable list of recent episodes on
 * the right (the layout Apple's old embed used before it dropped the list).
 * Audio plays in-page from the RSS <enclosure> URLs, so nothing third-party
 * can break or ignore the site theme.
 */
import type { ShowConfig } from '@/config/types';
import type { RssEpisode } from '@/utils/rss';

interface Props {
  show: ShowConfig;
  episodes: RssEpisode[];
  /** Max number of episodes listed in the player (the full list is below the player). */
  limit?: number;
}

const { show, episodes, limit = 30 } = Astro.props;

const playable = episodes.filter((e) => e.audioUrl);
const rows = playable.slice(0, limit);

/** "Oct 15, 2026" */
function shortDate(iso: string): string {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return '';
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
}

/** Accepts "hh:mm:ss", "mm:ss" or plain seconds and returns e.g. "5 min". */
function minutes(raw?: string): string {
  if (!raw) return '';
  const parts = raw.split(':').map(Number);
  if (parts.some(Number.isNaN)) return '';
  let secs = 0;
  if (parts.length === 3) secs = parts[0] * 3600 + parts[1] * 60 + parts[2];
  else if (parts.length === 2) secs = parts[0] * 60 + parts[1];
  else secs = parts[0];
  if (secs <= 0) return '';
  const m = Math.round(secs / 60);
  return m >= 60 ? `${Math.floor(m / 60)} hr ${m % 60} min` : `${Math.max(m, 1)} min`;
}

const artFile = show.artworkUrl ? show.artworkUrl.split('/').pop() ?? '' : '';
const artName = artFile.replace(/\.[^.]+$/, '');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const heading = show.heading ?? show.subtitle ?? show.title;
---

<section class="sp" aria-label={`${show.title} – episode player`} data-show-player>
  <div class="sp-main">
    <div class="sp-left">
      <picture class="sp-art">
        <source type="image/avif" srcset={['320', '640'].map((w) => `/images/optimized/${artName}-${w}.avif ${w}w`).join(', ')} sizes="260px" />
        <source type="image/webp" srcset={['320', '640'].map((w) => `/images/optimized/${artName}-${w}.webp ${w}w`).join(', ')} sizes="260px" />
        <img src={`${base}/${show.artworkUrl}`} alt={`${show.title} artwork`} width="260" height="260" decoding="async" />
      </picture>

      <div class="sp-meta">
        <p class="sp-title">{heading}</p>
        <p class="sp-sub">Small Talk Café Productions</p>
        <p class="sp-count">Language Learning · {episodes.length} episodes</p>
      </div>

      <button type="button" class="sp-latest" data-play-latest>
        <svg class="i-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.14v13.72a1 1 0 0 0 1.52.85l11-6.86a1 1 0 0 0 0-1.7l-11-6.86A1 1 0 0 0 8 5.14z" /></svg>
        <svg class="i-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1" /><rect x="14" y="5" width="4" height="14" rx="1" /></svg>
        <span>Latest Episode</span>
      </button>
    </div>

    <div class="sp-right">
      <ol class="sp-list">
        {rows.map((ep) => (
          <li>
            <button
              type="button"
              class="sp-row"
              data-src={ep.audioUrl}
              data-title={ep.title}
              aria-pressed="false"
              aria-label={`Play ${ep.title}`}
            >
              <span class="sp-row-text">
                <span class="sp-row-meta">
                  {[shortDate(ep.pubDate), minutes(ep.duration)].filter(Boolean).join(' · ')}
                </span>
                <span class="sp-row-title">{ep.title}</span>
              </span>
              <span class="sp-row-icon" aria-hidden="true">
                <svg class="i-play" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.14v13.72a1 1 0 0 0 1.52.85l11-6.86a1 1 0 0 0 0-1.7l-11-6.86A1 1 0 0 0 8 5.14z" /></svg>
                <svg class="i-pause" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="5" width="4" height="14" rx="1" /><rect x="14" y="5" width="4" height="14" rx="1" /></svg>
              </span>
            </button>
          </li>
        ))}
      </ol>
      <a class="sp-more" href="#episodes-heading">
        See All {episodes.length} Episodes
        <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
      </a>
    </div>
  </div>

  <div class="sp-bar" data-bar hidden>
    <p class="sp-now"><span class="sp-now-label">Now playing</span><span class="sp-now-title" data-now-title></span></p>
    <audio controls preload="none" data-audio></audio>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-show-player]');
  if (root) {
    const audio = root.querySelector<HTMLAudioElement>('[data-audio]')!;
    const bar = root.querySelector<HTMLElement>('[data-bar]')!;
    const nowTitle = root.querySelector<HTMLElement>('[data-now-title]')!;
    const latestBtn = root.querySelector<HTMLButtonElement>('[data-play-latest]');
    const rows = Array.from(root.querySelectorAll<HTMLButtonElement>('.sp-row'));
    let current: HTMLButtonElement | null = null;

    const sync = () => {
      const playing = !audio.paused && !audio.ended;
      rows.forEach((row) => {
        const active = row === current;
        row.classList.toggle('is-active', active);
        row.classList.toggle('is-playing', active && playing);
        row.setAttribute('aria-pressed', String(active && playing));
      });
      latestBtn?.classList.toggle('is-playing', current === rows[0] && playing);
    };

    const play = (row: HTMLButtonElement) => {
      if (row === current) {
        if (audio.paused) void audio.play();
        else audio.pause();
        return;
      }
      current = row;
      audio.src = row.dataset.src ?? '';
      nowTitle.textContent = row.dataset.title ?? '';
      bar.hidden = false;
      audio.play().catch(() => sync());
      sync();
    };

    rows.forEach((row) => row.addEventListener('click', () => play(row)));
    latestBtn?.addEventListener('click', () => rows[0] && play(rows[0]));
    ['play', 'pause', 'ended', 'emptied'].forEach((ev) => audio.addEventListener(ev, sync));
  }
</script>

<style>
  .sp {
    border: 1px solid var(--border);
    border-radius: 20px;
    background: var(--card);
    overflow: hidden;
    box-shadow: 0 10px 24px -8px rgba(82, 62, 38, 0.18);
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }
  :global(html.dark) .sp {
    box-shadow: 0 10px 24px -8px rgba(0, 0, 0, 0.5);
  }

  .sp-main {
    display: grid;
    grid-template-columns: minmax(250px, 300px) 1fr;
  }

  /* ── Left: artwork + meta + latest ─────────────────────────────── */
  .sp-left {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
  }
  .sp-art {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 14px;
    overflow: hidden;
    background: var(--bg-subtle);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.18);
  }
  .sp-art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .sp-title {
    margin: 0;
    font-family: 'Poppins', 'Helvetica Neue', sans-serif;
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--text);
  }
  .sp-sub {
    margin: 0.2rem 0 0;
    font-size: 0.9rem;
    color: var(--text-muted);
  }
  .sp-count {
    margin: 0.35rem 0 0;
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .sp-latest {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: auto;
    padding: 0.8rem 1rem;
    border: 0;
    border-radius: 12px;
    font: 600 0.95rem 'Inter', system-ui, sans-serif;
    cursor: pointer;
    color: var(--card);
    background: var(--text);
    transition: transform 0.15s ease, opacity 0.15s ease;
  }
  .sp-latest:hover { opacity: 0.88; }
  .sp-latest:active { transform: scale(0.98); }
  .sp-latest svg { width: 1rem; height: 1rem; }

  /* ── Right: episode list ───────────────────────────────────────── */
  .sp-right {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 1.25rem 1.5rem 1rem;
    background: var(--bg-subtle);
    border-left: 1px solid var(--border);
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }
  .sp-list {
    list-style: none;
    margin: 0;
    padding: 0 0.5rem 0 0;
    flex: 1;
    max-height: 360px;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .sp-list li { border-top: 1px solid var(--border); }
  .sp-list li:first-child { border-top: 0; }

  .sp-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    padding: 0.7rem 0.5rem;
    border: 0;
    border-radius: 10px;
    background: transparent;
    text-align: left;
    cursor: pointer;
    color: inherit;
    transition: background-color 0.15s ease;
  }
  .sp-row:hover { background: rgba(194, 122, 68, 0.1); }
  :global(html.dark) .sp-row:hover { background: rgba(176, 125, 90, 0.16); }
  .sp-row-text { display: flex; flex-direction: column; gap: 0.15rem; min-width: 0; flex: 1; }
  .sp-row-meta {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .sp-row-title {
    font-size: 0.93rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--text);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .sp-row-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 50%;
    border: 1px solid var(--border-hover);
    color: var(--text-muted);
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .sp-row-icon svg { width: 0.8rem; height: 0.8rem; }
  .sp-row:hover .sp-row-icon { color: var(--text); }
  .sp-row.is-active .sp-row-title { color: var(--accent); }
  .sp-row.is-active .sp-row-icon {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  /* play / pause icon swapping (rows + latest button) */
  .i-pause { display: none; }
  .is-playing .i-play { display: none; }
  .is-playing .i-pause { display: block; }

  .sp-more {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    align-self: flex-start;
    margin-top: 0.85rem;
    padding: 0.2rem 0;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
  }
  .sp-more svg { width: 1rem; height: 1rem; }
  .sp-more:hover { text-decoration: underline; }

  /* ── Now-playing bar ───────────────────────────────────────────── */
  .sp-bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 1.5rem;
    border-top: 1px solid var(--border);
    background: var(--card);
  }
  .sp-bar[hidden] { display: none; }
  .sp-now { display: flex; flex-direction: column; min-width: 0; flex: 0 1 38%; margin: 0; }
  .sp-now-label {
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .sp-now-title {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .sp-bar audio { flex: 1; min-width: 0; height: 40px; color-scheme: light; }
  :global(html.dark) .sp-bar audio { color-scheme: dark; }

  :focus-visible { outline: none; }
  .sp-row:focus-visible,
  .sp-latest:focus-visible,
  .sp-more:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* ── Mobile ────────────────────────────────────────────────────── */
  @media (max-width: 720px) {
    .sp-main { grid-template-columns: 1fr; }
    .sp-left {
      display: grid;
      grid-template-columns: 96px 1fr;
      grid-template-areas: 'art meta' 'btn btn';
      align-items: center;
      gap: 0.9rem 1rem;
      padding: 1rem;
    }
    .sp-art { grid-area: art; }
    .sp-meta { grid-area: meta; }
    .sp-latest { grid-area: btn; margin-top: 0; }
    .sp-right { border-left: 0; border-top: 1px solid var(--border); padding: 1rem; }
    .sp-list { max-height: 320px; }
    .sp-bar { flex-direction: column; align-items: stretch; gap: 0.4rem; padding: 0.75rem 1rem; }
    .sp-now { flex: none; }
  }
</style>
