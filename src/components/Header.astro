---
/**
 * Header Component
 * 
 * Site header with brand logo/name and social media navigation links.
 * Styled to match Shopify store aesthetic with clean design.
 */

import PlatformLink from './PlatformLink.astro';
import { siteConfig } from '@/config/site';

const { brand, socialLinks } = siteConfig;
const base = import.meta.env.BASE_URL.replace(/\/$/, ''); // Remove trailing slash for consistency
---

<header class="sticky top-0 z-50 border-b transition-colors duration-300" style="background-color:var(--bg); border-color:var(--border);">
  <nav class="container-custom py-3 md:py-4" aria-label="Main navigation">
    <div class="flex items-center justify-between">
      <!-- Brand Logo/Name -->
      <div class="flex items-center gap-2">
        <a href={`${base}/`} class="flex items-center gap-2 group">
          <span class="text-base md:text-lg font-bold font-heading tracking-tight transition-colors" style="color:var(--text);">
            {brand.name}
          </span>
        </a>
      </div>

      <!-- Navigation & Social Links -->
      <div class="flex items-center gap-4 sm:gap-5">
        <a
          href={`${base}/languagelounge/`}
          class="font-heading font-semibold hover:opacity-80 transition-colors text-sm md:text-base"
          style="color:var(--text);"
        >
          Language Lounge
        </a>

        <!-- Shows Link -->
        <a
          href={`${base}/shows/`}
          class="font-heading font-semibold hover:opacity-80 transition-colors text-sm md:text-base"
          style="color:var(--text);"
        >
          Shows
        </a>

        <!-- Shop Link (internal merch page) -->
        <a
          href={`${base}/shop/`}
          class="font-heading font-semibold hover:opacity-80 transition-colors text-sm md:text-base"
          style="color:var(--text);"
        >
          Shop
        </a>

        <!-- About Link -->
        <a
          href={`${base}/about/`}
          class="font-heading font-semibold hover:opacity-80 transition-colors text-sm md:text-base hidden md:inline"
          style="color:var(--text);"
        >
          About
        </a>

        <!-- Divider -->
        <div class="h-5 w-px hidden sm:block" style="background-color:var(--border);"></div>

        <!-- Social Navigation Links -->
        <PlatformLink
          href={socialLinks.instagram}
          label="Follow us on Instagram"
          class="hover:opacity-70 transition-opacity"
          style="color:var(--text);"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
          <span class="sr-only">Instagram</span>
        </PlatformLink>

        <PlatformLink
          href={socialLinks.youtube}
          label="Visit our YouTube channel"
          class="hover:opacity-70 transition-opacity"
          style="color:var(--text);"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
          </svg>
          <span class="sr-only">YouTube</span>
        </PlatformLink>

        <!-- Dark/Light Toggle -->
        <button
          id="theme-toggle"
          class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg border text-sm font-semibold transition-all hover:opacity-70"
          style="border-color:var(--border); color:var(--text-muted); background-color:var(--card);"
          aria-label="Toggle dark/light mode"
        >
          <span id="theme-icon">☀️</span>
          <span id="theme-label" class="hidden sm:inline">Light</span>
        </button>

      </div>
    </div>
  </nav>
</header>
