---
/**
 * ProductCard Component
 *
 * Displays a single Shopify product styled exactly as seen on the Shop page.
 */
import { formatPrice } from '@/utils/shopify';

interface Props {
  product: any;
}

const { product } = Astro.props;

if (!product) return null;

const image = product.images?.[0];
const onSale = product.compareAtPrice &&
  parseFloat(product.compareAtPrice) > parseFloat(product.price);
---

<a
  href={product.url}
  target="_blank"
  rel="noopener noreferrer"
  class="product-card group"
  aria-label={`${product.title} — ${formatPrice(product.price)}`}
>
  <!-- Product image -->
  <div class="product-img-wrap">
    {image ? (
      <picture>
        <source
          type="image/avif"
          srcset={[800, 600, 400, 300].map(w => `${image.src}${image.src.includes('?') ? '&' : '?'}width=${w} ${w}w`).join(', ')}
          sizes="(max-width: 640px) 300px, (max-width: 1024px) 600px, 800px"
        />
        <source
          type="image/webp"
          srcset={[800, 600, 400, 300].map(w => `${image.src}${image.src.includes('?') ? '&' : '?'}width=${w} ${w}w`).join(', ')}
          sizes="(max-width: 640px) 300px, (max-width: 1024px) 600px, 800px"
        />
        <img
          src={image.src}
          alt={image.alt ?? product.title}
          width={image.width || 600}
          height={image.height || 600}
          loading="lazy"
          decoding="async"
          fetchpriority="auto"
          class="product-img"
        />
      </picture>
    ) : (
      <div class="product-img-placeholder" aria-hidden="true">🛍️</div>
    )}
    {onSale && (
      <span class="sale-badge" aria-label="On sale">Sale</span>
    )}
    {!product.available && (
      <span class="sold-out-badge" aria-label="Sold out">Sold Out</span>
    )}
  </div>

  <!-- Product info -->
  <div class="product-info">
    {product.productType && (
      <p class="product-type">{product.productType}</p>
    )}
    <h3 class="product-title group-hover:text-brand-accent transition-colors">
      {product.title}
    </h3>
    {product.teaser && (
      <p class="product-teaser">{product.teaser}</p>
    )}
    <div class="product-price-row">
      <span class="product-price">{formatPrice(product.price)}</span>
      {onSale && product.compareAtPrice && (
        <span class="product-compare-price">
          {formatPrice(product.compareAtPrice)}
        </span>
      )}
    </div>
    <span class="product-cta" aria-hidden="true">
      Shop Now
      <svg class="w-4 h-4 inline-block ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
      </svg>
    </span>
  </div>
</a>

<style>
  /* ── Product card ─────────────────────────────────────────────────── */
  .product-card {
    display: flex;
    flex-direction: column;
    background: white;
    border: 1.5px solid rgba(82, 62, 38, 0.08);
    border-radius: 20px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.2s, transform 0.2s;
    height: 100%;
  }
  .product-card:hover {
    box-shadow: 0 8px 30px rgba(82, 62, 38, 0.12);
    transform: translateY(-2px);
  }

  .product-img-wrap {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #f5f1e8;
  }
  .product-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .product-card:hover .product-img {
    transform: scale(1.04);
  }
  .product-img-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    font-size: 3.5rem;
  }

  .sale-badge,
  .sold-out-badge {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.2rem 0.55rem;
    border-radius: 99px;
  }
  .sale-badge {
    background: #F39C12;
    color: white;
  }
  .sold-out-badge {
    background: rgba(82, 62, 38, 0.65);
    color: white;
  }

  .product-info {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.1rem 1.25rem 1.35rem;
    flex-grow: 1;
  }

  .product-type {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #F39C12;
    margin: 0;
  }

  .product-title {
    font-family: "Poppins", "Helvetica Neue", sans-serif;
    font-size: 0.975rem;
    font-weight: 700;
    color: #523E26;
    margin: 0;
    line-height: 1.35;
  }

  .product-teaser {
    font-size: 0.8rem;
    color: rgba(82, 62, 38, 0.6);
    margin: 0;
    line-height: 1.5;
    flex-grow: 1;
    /* clamp to 2 lines */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .product-price-row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  .product-price {
    font-family: "Poppins", "Helvetica Neue", sans-serif;
    font-size: 1rem;
    font-weight: 700;
    color: #523E26;
  }

  .product-compare-price {
    font-size: 0.8rem;
    color: rgba(82, 62, 38, 0.45);
    text-decoration: line-through;
  }

  .product-cta {
    display: inline-flex;
    align-items: center;
    font-size: 0.8rem;
    font-weight: 600;
    color: #F39C12;
    margin-top: 0.5rem;
    transition: gap 0.15s;
  }
  .product-card:hover .product-cta {
    gap: 0.35rem;
  }
</style>
