---
/**
 * ShowDisplay Component
 * 
 * Reusable component for displaying a podcast show with artwork, title,
 * description, and platform buttons. Used on both the homepage (featured show)
 * and the shows page for consistent styling.
 */

import PlatformLink from './PlatformLink.astro';
import { siteConfig } from '@/config/site';
import type { ShowConfig } from '@/config/types';

interface Props {
  show: ShowConfig;
  showTitle?: boolean;
  showDescription?: boolean;
  headingLevel?: 'h1' | 'h2';
  linkable?: boolean; // If true, artwork and title link to individual show page
}

const { 
  show, 
  showTitle = true, 
  showDescription = true,
  headingLevel = 'h2',
  linkable = false
} = Astro.props;

// Get font configuration for show title
const showTitleFont = siteConfig.brand.fonts.showTitle?.family || siteConfig.brand.fonts.heading;
const showTitleSizeLarge = siteConfig.brand.fonts.showTitle?.sizeLarge || '2.5rem';
const showTitleSizeSmall = siteConfig.brand.fonts.showTitle?.sizeSmall || '2rem';

const HeadingTag = headingLevel;
const base = import.meta.env.BASE_URL.replace(/\/$/, ''); // Remove trailing slash for consistency
// Safe artwork filename (without extension) for building optimized srcset paths
const _artworkFile = show.artworkUrl ? show.artworkUrl.split('/').pop() : '';
const _artworkName = _artworkFile ? _artworkFile.replace(/\.[^.]+$/, '') : 'podcasts';
---

<div class="show-display">
  <div class="flex flex-col items-center text-center max-w-2xl mx-auto gap-8">
    <!-- Show Artwork -->
    <div class="w-full max-w-md">
      {linkable ? (
        <a href={`${base}/shows/${show.id}/`} class="block aspect-square rounded-lg overflow-hidden shadow-2xl hover:shadow-xl transition-shadow duration-200">
          {
            /* Responsive picture: prefer AVIF -> WebP -> JPEG fallback. Generated images live in /images/optimized/<name>-{w}.{fmt} */
          }
          <picture>
            <source
              type="image/avif"
              srcset={['1600','1024','640','320'].map(w => `/images/optimized/${_artworkName}-${w}.avif ${w}w`).join(', ')}
              sizes="(max-width: 640px) 320px, (max-width: 1024px) 640px, 1024px"
            />
            <source
              type="image/webp"
              srcset={['1600','1024','640','320'].map(w => `/images/optimized/${_artworkName}-${w}.webp ${w}w`).join(', ')}
              sizes="(max-width: 640px) 320px, (max-width: 1024px) 640px, 1024px"
            />
            <img
              src={`${base}/${show.artworkUrl}`}
              alt={`${show.title} - Show Artwork`}
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-200"
              loading="lazy"
              decoding="async"
              fetchpriority={linkable ? 'high' : 'auto'}
              width="1200"
              height="1200"
            />
          </picture>
        </a>
      ) : (
        <div class="aspect-square rounded-lg overflow-hidden shadow-2xl">
          <picture>
            <source
              type="image/avif"
              srcset={['1600','1024','640','320'].map(w => `/images/optimized/${_artworkName}-${w}.avif ${w}w`).join(', ')}
              sizes="(max-width: 640px) 320px, (max-width: 1024px) 640px, 1024px"
            />
            <source
              type="image/webp"
              srcset={['1600','1024','640','320'].map(w => `/images/optimized/${_artworkName}-${w}.webp ${w}w`).join(', ')}
              sizes="(max-width: 640px) 320px, (max-width: 1024px) 640px, 1024px"
            />
            <img
              src={`${base}/${show.artworkUrl}`}
              alt={`${show.title} - Show Artwork`}
              class="w-full h-full object-cover"
              loading="lazy"
              decoding="async"
              fetchpriority={linkable ? 'high' : 'auto'}
              width="1200"
              height="1200"
            />
          </picture>
        </div>
      )}
    </div>

    <!-- Show Details -->
    <div class="w-full flex flex-col items-center">
      {showTitle && (
        linkable ? (
          <a href={`${base}/shows/${show.id}/`} class="hover:opacity-80 transition-opacity text-center">
            <HeadingTag class="show-title font-normal text-brand-secondary mb-2">
              {show.title}
            </HeadingTag>
            {show.subtitle && (
              <p class="show-subtitle font-normal text-brand-secondary mb-4">
                {show.subtitle}
              </p>
            )}
          </a>
        ) : (
          <div class="text-center">
            <HeadingTag class="show-title font-normal text-brand-secondary mb-2">
              {show.title}
            </HeadingTag>
            {show.subtitle && (
              <p class="show-subtitle font-normal text-brand-secondary mb-4">
                {show.subtitle}
              </p>
            )}
          </div>
        )
      )}
      
      {showDescription && (
        <p class="text-brand-secondary/80 text-lg leading-relaxed mb-8">
          {show.description}
        </p>
      )}

      <!-- Listen Buttons -->
      <div class="flex flex-col sm:flex-row gap-4">
        <PlatformLink
          href={show.spotifyUrl}
          label="Listen on Spotify"
          class="btn btn-primary"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/>
          </svg>
          Listen on Spotify
        </PlatformLink>

        <PlatformLink
          href={show.applePodcastsUrl}
          label="Listen on Apple Podcasts"
          class="btn btn-secondary"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c3.87 0 7 3.13 7 7s-3.13 7-7 7-7-3.13-7-7 3.13-7 7-7zm0 2c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zm0 2c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 1.5c-.83 0-1.5.67-1.5 1.5v1.5a1.5 1.5 0 0 0 3 0V12c0-.83-.67-1.5-1.5-1.5zm0 6a1 1 0 1 0 0 2 1 1 0 0 0 0-2z"/>
          </svg>
          Apple Podcasts
        </PlatformLink>
      </div>
    </div>
  </div>
</div>

<style define:vars={{ showTitleFont, showTitleSizeSmall, showTitleSizeLarge }}>
  .show-title,
  .show-subtitle {
    font-family: var(--showTitleFont);
    font-size: var(--showTitleSizeSmall);
  }
  
  @media (min-width: 768px) {
    .show-title,
    .show-subtitle {
      font-size: var(--showTitleSizeLarge);
    }
  }

  .btn {
    @apply inline-flex items-center gap-2 px-6 py-3 rounded-lg font-semibold transition-colors;
  }
  
  .btn-primary {
    @apply bg-brand-secondary text-white hover:bg-brand-secondary/90;
  }
  
  .btn-secondary {
    @apply bg-brand-accent text-white hover:bg-brand-accent/90;
  }
</style>
