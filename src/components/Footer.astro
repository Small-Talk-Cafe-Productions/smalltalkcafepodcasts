---
/**
 * Footer Component
 *
 * Site footer with navigation links, privacy policy, contact, and copyright.
 */

import { siteConfig } from '@/config/site';

const { footer, socialLinks } = siteConfig;
const currentYear = footer.copyrightYear || new Date().getFullYear();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="border-t pt-10 pb-6 transition-colors duration-300" style="background-color:var(--bg); border-color:var(--border);">
  <div class="container-custom">

    <!-- Top row: brand + nav columns -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-8">

      <!-- Brand -->
      <div class="col-span-2 md:col-span-1">
        <a href={`${base}/`} class="text-base font-semibold text-brand-secondary hover:opacity-70 transition-opacity">
          Small Talk Café Podcasts
        </a>
        <p class="text-brand-secondary/50 text-xs mt-2 leading-relaxed mb-2">
          Bite-sized podcast lessons to learn Spanish, French, Italian, Portuguese, Dutch, Swedish, Japanese, Korean, Mandarin &amp; German — in minutes a day.
        </p>
        <p class="text-brand-secondary/50 text-xs mb-1">Munich, Germany</p>
        <a href="mailto:smalltalkcafe.productions@gmail.com" class="text-brand-secondary/50 text-xs underline underline-offset-2 hover:opacity-70 transition-opacity break-all">
          smalltalkcafe.productions@gmail.com
        </a>
      </div>

      <!-- Explore -->
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-brand-secondary/50 mb-3">Explore</p>
        <ul class="space-y-2 text-sm">
          <li><a href={`${base}/shows/`} class="text-brand-secondary/70 hover:text-brand-secondary transition-colors">Shows</a></li>
          <li><a href={`${base}/about/`} class="text-brand-secondary/70 hover:text-brand-secondary transition-colors">About Us</a></li>
          <li><a href={`${base}/contact/`} class="text-brand-secondary/70 hover:text-brand-secondary transition-colors">Contact</a></li>
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-brand-secondary/50 mb-3">Legal</p>
        <ul class="space-y-2 text-sm">
          <li><a href={`${base}/privacy-policy/`} class="text-brand-secondary/70 hover:text-brand-secondary transition-colors">Privacy Policy</a></li>
          <li><a href={`${base}/impressum/`} class="text-brand-secondary/70 hover:text-brand-secondary transition-colors">Impressum</a></li>
        </ul>
      </div>

      <!-- Follow -->
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-brand-secondary/50 mb-3">Follow</p>
        <ul class="space-y-2 text-sm">
          <li>
            <a href={socialLinks.instagram} target="_blank" rel="noopener noreferrer" class="text-brand-secondary/70 hover:text-brand-secondary transition-colors">
              Instagram
            </a>
          </li>
          <li>
            <a href={socialLinks.youtube} target="_blank" rel="noopener noreferrer" class="text-brand-secondary/70 hover:text-brand-secondary transition-colors">
              YouTube
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom row: copyright -->
    <div class="border-t pt-5 flex flex-col md:flex-row items-center justify-between gap-2" style="border-color:var(--border);">
      <div class="flex flex-col items-start">
        <p class="text-brand-secondary/60 text-xs">
          © {currentYear} Small Talk Café Podcasts. All rights reserved.
        </p>
        <!-- Email moved to bottom footer -->
      </div>
      <p class="text-brand-secondary/40 text-xs">
        {footer.copyrightText}
      </p>
    </div>

  </div>
</footer>
