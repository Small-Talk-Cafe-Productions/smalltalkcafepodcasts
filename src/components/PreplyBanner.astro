---
/**
 * PreplyBanner
 *
 * Affiliate advertisement banner for Preply.
 * Promotes the 50% off first lesson offer with the tracking link.
 * Designed to be clean, on-brand, and unobtrusive yet engaging.
 *
 * Usage:
 *   <PreplyBanner />
 */
---

<aside
  class="preply-banner"
  aria-label="Sponsored: Learn languages with Preply"
>
  <div class="preply-banner__inner">

    <!-- Top row: icon + label -->
    <div class="preply-banner__top">
      <div class="preply-banner__icon" aria-hidden="true">
        <!-- Speech-bubble language icon -->
        <svg width="36" height="36" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="16" cy="16" r="16" fill="#F39C12" fill-opacity="0.15"/>
          <path d="M8 10.5C8 9.12 9.12 8 10.5 8h11C22.88 8 24 9.12 24 10.5v7C24 18.88 22.88 20 21.5 20H18l-4 4v-4h-3.5C9.12 20 8 18.88 8 17.5v-7z" fill="#F39C12"/>
          <circle cx="12" cy="14" r="1.25" fill="#F5F1E8"/>
          <circle cx="16" cy="14" r="1.25" fill="#F5F1E8"/>
          <circle cx="20" cy="14" r="1.25" fill="#F5F1E8"/>
        </svg>
      </div>
      <span class="preply-banner__label">Sponsored</span>
    </div>

    <!-- Copy -->
    <div class="preply-banner__copy">
      <p class="preply-banner__headline">
        Speak German fluently — with a real tutor
      </p>
      <p class="preply-banner__sub">
        Get <strong>50% off your first lesson</strong> on <strong>Preply</strong>. Learn with expert tutors, on your schedule.
      </p>
    </div>

    <!-- CTA -->
    <a
      id="preply-banner-cta"
      href="https://preply.sjv.io/c/7286863/1987575/24422"
      target="_blank"
      rel="noopener noreferrer sponsored"
      class="preply-banner__cta"
      aria-label="Claim 50% off your first Preply lesson (opens in a new tab)"
    >
      Claim 50% Off
      <svg class="preply-banner__cta-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14M12 5l7 7-7 7"/>
      </svg>
    </a>

  </div>
</aside>

<style>
  /* ── Container ────────────────────────────────────────────────── */
  .preply-banner {
    position: relative;
    overflow: hidden;
    border-radius: 18px;
    background: linear-gradient(
      135deg,
      rgba(243, 156, 18, 0.12) 0%,
      rgba(243, 156, 18, 0.04) 60%,
      rgba(82, 62, 38, 0.04) 100%
    );
    border: 1.5px solid rgba(243, 156, 18, 0.28);
    box-shadow: 0 2px 16px rgba(243, 156, 18, 0.08);
    /* Square-ish: fixed max-width so height-to-width ratio stays close to 1:2 */
    max-width: 480px;
    margin: 0 auto;
    padding: 2rem 2rem;
    transition: box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .preply-banner:hover {
    box-shadow: 0 4px 24px rgba(243, 156, 18, 0.14);
    border-color: rgba(243, 156, 18, 0.45);
  }

  /* Subtle animated shimmer accent in the top-left corner */
  .preply-banner::before {
    content: '';
    position: absolute;
    top: -40px;
    left: -40px;
    width: 180px;
    height: 180px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(243,156,18,0.12) 0%, transparent 70%);
    pointer-events: none;
    animation: preply-glow 4s ease-in-out infinite alternate;
  }
  @keyframes preply-glow {
    from { opacity: 0.6; transform: scale(1); }
    to   { opacity: 1;   transform: scale(1.12); }
  }

  /* ── Inner column ──────────────────────────────────────────── */
  .preply-banner__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* ── Top row: icon + label ──────────────────────────────────── */
  .preply-banner__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* ── "Sponsored" label ────────────────────────────────────── */
  .preply-banner__label {
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(82, 62, 38, 0.38);
  }

  /* ── Icon bubble ─────────────────────────────────────────────── */
  .preply-banner__icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
  }

  /* ── Copy ────────────────────────────────────────────────────── */
  .preply-banner__copy {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .preply-banner__headline {
    font-family: 'Poppins', sans-serif;
    font-size: 1.0625rem;
    font-weight: 700;
    color: #523E26;
    margin: 0;
    line-height: 1.3;
  }
  .preply-banner__sub {
    font-size: 0.875rem;
    color: rgba(82, 62, 38, 0.70);
    margin: 0;
    line-height: 1.55;
  }
  .preply-banner__sub strong {
    color: #523E26;
    font-weight: 700;
  }

  /* ── CTA button ──────────────────────────────────────────────── */
  .preply-banner__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
    align-self: flex-start;
    background: #F39C12;
    color: #fff;
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    font-size: 0.875rem;
    padding: 0.65rem 1.5rem;
    border-radius: 9999px;
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.2s, transform 0.2s;
    box-shadow: 0 2px 8px rgba(243, 156, 18, 0.35);
    margin-top: 0.25rem;
  }
  .preply-banner__cta:hover {
    opacity: 0.88;
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(243, 156, 18, 0.45);
  }
  .preply-banner__cta-arrow {
    flex-shrink: 0;
    transition: transform 0.2s;
  }
  .preply-banner__cta:hover .preply-banner__cta-arrow {
    transform: translateX(2px);
  }

  /* ── Responsive ──────────────────────────────────────────────── */
  @media (max-width: 639px) {
    .preply-banner {
      max-width: 100%;
      padding: 1.5rem;
    }
  }
</style>
