---
/**
 * ShopProductBanner (replaces PreplyBanner)
 *
 * Shows a featured product from the Shopify store as an inline horizontal card component.
 * Selects a product randomly on the client-side on every page visit.
 *
 * Usage:
 *   <PreplyBanner />   (drop-in replacement, same slot on every page)
 */

import { fetchShopifyProducts, formatPrice } from '@/utils/shopify';

// Fetch all live products at build time
const productsRaw = await fetchShopifyProducts();
const hasProducts = productsRaw.length > 0;

// Transform the products array to a clean serialized array for client-side use
const products = productsRaw.map(p => ({
  title: p.title?.split('|')[0]?.trim() ?? p.title ?? '',
  url: p.url,
  imageSrc: p.images?.[0]?.src ?? '',
  imageAlt: p.images?.[0]?.alt ?? p.title ?? '',
  teaser: p.teaser ?? '',
  priceFormatted: formatPrice(p.price),
  comparePriceFormatted: p.compareAtPrice ? formatPrice(p.compareAtPrice) : null,
  onSale: p.compareAtPrice && parseFloat(p.compareAtPrice) > parseFloat(p.price)
}));
---

{hasProducts && (
  <aside class="shop-banner" aria-label="Featured product from the Small Talk Café shop" style="display: none;">
    <div class="shop-banner__container">
      
      <!-- Left side: Image -->
      <div class="shop-banner__img-wrap">
        <a class="shop-banner__img-anchor" href="#" target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true">
          <img
            class="shop-banner__img"
            src=""
            alt=""
            width="300"
            height="300"
            loading="lazy"
            decoding="async"
          />
        </a>
      </div>

      <!-- Right side: Details -->
      <div class="shop-banner__details">
        <div class="shop-banner__header">
          <span class="shop-banner__eyebrow">From the Shop</span>
          <h3 class="shop-banner__title"></h3>
        </div>
        
        <p class="shop-banner__teaser"></p>
        
        <div class="shop-banner__footer">
          <div class="shop-banner__price-row">
            <span class="shop-banner__price"></span>
            <span class="shop-banner__compare-price" style="display: none;"></span>
          </div>
          
          <a
            class="shop-banner__cta"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
          >
            Shop Now
            <svg class="shop-banner__arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      </div>

    </div>
  </aside>
)}

<script define:vars={{ products }}>
  if (products && products.length > 0) {
    const banners = document.querySelectorAll('.shop-banner');
    
    banners.forEach(banner => {
      // Pick a random product from the list for this banner instance
      const randomProduct = products[Math.floor(Math.random() * products.length)];
      if (!randomProduct) return;
      
      const imgLink = banner.querySelector('.shop-banner__img-anchor');
      const img = banner.querySelector('.shop-banner__img');
      const titleEl = banner.querySelector('.shop-banner__title');
      const teaserEl = banner.querySelector('.shop-banner__teaser');
      const priceEl = banner.querySelector('.shop-banner__price');
      const comparePriceEl = banner.querySelector('.shop-banner__compare-price');
      const cta = banner.querySelector('.shop-banner__cta');
      
      // Update DOM
      if (imgLink) imgLink.href = randomProduct.url;
      if (img) {
        img.src = randomProduct.imageSrc;
        img.alt = randomProduct.imageAlt;
      }
      if (titleEl) titleEl.textContent = randomProduct.title;
      if (teaserEl) teaserEl.textContent = randomProduct.teaser;
      if (priceEl) priceEl.textContent = randomProduct.priceFormatted;
      
      if (comparePriceEl) {
        if (randomProduct.comparePriceFormatted) {
          comparePriceEl.textContent = randomProduct.comparePriceFormatted;
          comparePriceEl.style.display = 'inline';
        } else {
          comparePriceEl.style.display = 'none';
        }
      }
      
      if (cta) {
        cta.href = randomProduct.url;
        cta.setAttribute('aria-label', `Buy ${randomProduct.title} in the Small Talk Café shop (opens in a new tab)`);
      }
      
      // Show the banner now that it is populated
      banner.style.display = 'block';
    });
  }
</script>

<style>
  /* ── Banner Container ───────────────────────────────────────────── */
  .shop-banner {
    max-width: 760px;
    margin: 2rem auto;
    background: #ffffff;
    border: 1.5px solid rgba(82, 62, 38, 0.08);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(82, 62, 38, 0.03);
    transition: box-shadow 0.25s ease, transform 0.25s ease;
  }
  .shop-banner:hover {
    box-shadow: 0 8px 30px rgba(82, 62, 38, 0.09);
    transform: translateY(-1px);
  }

  .shop-banner__container {
    display: flex;
    flex-direction: row;
    align-items: stretch;
  }
  @media (max-width: 640px) {
    .shop-banner__container {
      flex-direction: column;
    }
  }

  /* ── Left side: Product Image ────────────────────────────────────── */
  .shop-banner__img-wrap {
    width: 200px;
    flex-shrink: 0;
    aspect-ratio: 1 / 1;
    background: #f5f1e8;
    overflow: hidden;
  }
  @media (max-width: 640px) {
    .shop-banner__img-wrap {
      width: 100%;
      aspect-ratio: 16 / 9;
    }
  }
  .shop-banner__img-anchor {
    display: block;
    width: 100%;
    height: 100%;
  }
  .shop-banner__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .shop-banner:hover .shop-banner__img {
    transform: scale(1.03);
  }

  /* ── Right side: Product Details ─────────────────────────────────── */
  .shop-banner__details {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    min-width: 0;
  }
  @media (max-width: 640px) {
    .shop-banner__details {
      gap: 0.75rem;
    }
  }

  .shop-banner__header {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .shop-banner__eyebrow {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #F39C12;
    margin: 0;
  }

  .shop-banner__title {
    font-family: "Poppins", "Helvetica Neue", sans-serif;
    font-size: 1.05rem;
    font-weight: 700;
    color: #523E26;
    margin: 0;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  @media (max-width: 640px) {
    .shop-banner__title {
      white-space: normal;
    }
  }

  .shop-banner__teaser {
    font-size: 0.8rem;
    color: rgba(82, 62, 38, 0.6);
    margin: 0.35rem 0 0.75rem;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .shop-banner__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid rgba(82, 62, 38, 0.06);
    padding-top: 0.75rem;
    margin-top: auto;
  }

  .shop-banner__price-row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .shop-banner__price {
    font-family: "Poppins", "Helvetica Neue", sans-serif;
    font-size: 1.05rem;
    font-weight: 700;
    color: #523E26;
  }

  .shop-banner__compare-price {
    font-size: 0.8rem;
    color: rgba(82, 62, 38, 0.45);
    text-decoration: line-through;
  }

  /* ── CTA button ────────────────────────────────────────────────── */
  .shop-banner__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
    background: #F39C12;
    color: #fff;
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    font-size: 0.8rem;
    padding: 0.5rem 1.1rem;
    border-radius: 9999px;
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.2s, transform 0.2s;
    box-shadow: 0 2px 8px rgba(243, 156, 18, 0.25);
  }
  .shop-banner__cta:hover {
    opacity: 0.88;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(243, 156, 18, 0.35);
  }
  .shop-banner__arrow {
    flex-shrink: 0;
    transition: transform 0.2s;
  }
  .shop-banner__cta:hover .shop-banner__arrow {
    transform: translateX(2px);
  }
</style>
