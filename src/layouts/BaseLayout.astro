---
/**
 * BaseLayout
 * 
 * Main layout wrapper with SEO meta tags, Open Graph, Twitter Cards,
 * and Schema.org structured data.
 */

import '@/styles/global.css';
import { siteConfig } from '@/config/site';
import { generateOGTags, generateTwitterTags } from '@/config/seo';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  /** Override og:type — defaults to 'website'. Use 'article' for episode pages. */
  ogType?: string;
  /** Override the OG/Twitter share image — defaults to the global OG image. */
  ogImage?: string;
  /** BCP 47 language code for <html lang>. Defaults to 'en'. */
  lang?: string;
  /** IETF locale for og:locale, e.g. 'en_US', 'es_ES'. Defaults to 'en_US'. */
  locale?: string;
  /** hreflang link tags to inject: [ { lang, href } ] */
  hreflangLinks?: Array<{ lang: string; href: string }>;
  /** RSS feed URL — adds <link rel="alternate" type="application/rss+xml"> */
  rssFeedUrl?: string;
  /** Apple Podcasts numeric show ID for iOS smart-banner meta tag */
  applePodcastsId?: string;
  /** Apple Podcasts full show URL for smart-banner deep-link */
  applePodcastsUrl?: string;
}

const {
  title,
  description,
  canonicalUrl,
  ogType = 'website',
  ogImage,
  lang = 'en',
  locale = 'en_US',
  hreflangLinks,
  rssFeedUrl,
  applePodcastsId,
  applePodcastsUrl,
} = Astro.props;
const { seo } = siteConfig;

// Use the passed canonical if provided, otherwise fall back to the real current URL
const pageCanonical = canonicalUrl ?? new URL(Astro.url.pathname, seo.siteUrl).toString();

const pageTitle = title || seo.title;
const pageDescription = description || seo.description;
const pageOgImage = ogImage || seo.ogImage;

// Generate Open Graph and Twitter tags using the page-specific title/description
// (not the featured show's data, which would contaminate non-homepage pages)
const ogTags = generateOGTags(seo);
const twitterTags = generateTwitterTags(seo);
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/images/podcasts.svg" />
    <meta name="generator" content={Astro.generator} />
    <!-- Brand colour for Chrome/Edge Android address bar -->
    <meta name="theme-color" content="#F5F1E8" />

    <!-- Primary Meta Tags -->
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={seo.keywords.join(', ')} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={pageOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />
    <meta property="og:locale" content={locale} />
    <meta property="og:site_name" content={ogTags['og:site_name']} />

    <!-- Twitter -->
    <meta property="twitter:card" content={twitterTags['twitter:card']} />
    <meta property="twitter:url" content={pageCanonical} />
    <meta property="twitter:title" content={pageTitle} />
    <meta property="twitter:description" content={pageDescription} />
    <meta property="twitter:image" content={pageOgImage} />
    <meta property="twitter:image:alt" content={pageTitle} />
    {twitterTags['twitter:site'] && (
      <meta property="twitter:site" content={twitterTags['twitter:site']} />
    )}
    <!-- Canonical Link (unique per page — critical for Google deduplication) -->
    <link rel="canonical" href={pageCanonical} />

    <!-- hreflang: declare language targeting to Google (international SEO) -->
    {hreflangLinks && hreflangLinks.map(({ lang: l, href }) => (
      <link rel="alternate" hreflang={l} href={href} />
    ))}

    <!-- RSS feed discovery (podcast clients + Google) -->
    {rssFeedUrl && (
      <link rel="alternate" type="application/rss+xml" title={pageTitle} href={rssFeedUrl} />
    )}

    <!-- Apple Podcasts iOS smart-banner: lets mobile visitors open the Podcasts app directly -->
    {applePodcastsId && applePodcastsUrl && (
      <meta name="apple-itunes-app" content={`app-id=525463029, app-argument=${applePodcastsUrl}`} />
    )}

    <!-- Per-page head extras (additional schema, overrides, etc.) -->
    <slot name="head-extras" />

    <!-- Google Search Console ownership verification -->
    {seo.googleSearchConsoleVerification && (
      <meta name="google-site-verification" content={seo.googleSearchConsoleVerification} />
    )}

    <!-- Google Analytics 4 — load only after user interaction or a 5s idle fallback to avoid blocking TBT -->
    {seo.googleAnalyticsId && (
      <script is:inline define:vars={{ gaId: seo.googleAnalyticsId }}>
        (function(){
          var loaded = false;
          function loadGA(){
            if (loaded) return; loaded = true;
            try {
              var s = document.createElement('script');
              s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
              s.async = true;
              document.head.appendChild(s);
              window.dataLayer = window.dataLayer || [];
              function gtag(){dataLayer.push(arguments);} 
              window.gtag = gtag;
              gtag('js', new Date());
              gtag('config', gaId, { 'anonymize_ip': true });
            } catch (e) { /* swallow errors */ }
            removeListeners();
          }
          function onUserInteraction() { loadGA(); }
          function removeListeners(){
            ['scroll','pointerdown','keydown','touchstart'].forEach(function(ev){
              window.removeEventListener(ev, onUserInteraction, { passive: true });
            });
            document.removeEventListener('visibilitychange', visibilityHandler);
            if (gaTimer) clearTimeout(gaTimer);
          }
          function visibilityHandler(){ if (document.visibilityState === 'visible') { loadGA(); } }
          // Load only after explicit user interaction or when the page is visible and 5s elapsed
          var gaTimer = setTimeout(function(){ if (!loaded && document.visibilityState === 'visible') loadGA(); }, 5000);
          ['scroll','pointerdown','keydown','touchstart'].forEach(function(ev){
            window.addEventListener(ev, onUserInteraction, { passive: true, once: true });
          });
          document.addEventListener('visibilitychange', visibilityHandler, { once: true });
        })();
      </script>
    )}

    <!-- Preconnect to external domains for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    
    <!-- Brand Fonts (Google Fonts) - non-blocking preload with onload swap -->
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@600;700;800&display=swap" as="style" onload="this.setAttribute('rel','stylesheet')" />
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet" />
    </noscript>
    <!-- Inline critical CSS (minimal: background and container) to reduce render-blocking CSS for above-the-fold content -->
    <style>
      html, body { background: #F5F1E8; color: #121212; }
      .container-custom { max-width: 1200px; margin-left: auto; margin-right: auto; padding-left: 1rem; padding-right: 1rem; }
      .min-h-screen { min-height: 100vh; }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
